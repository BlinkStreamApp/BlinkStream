# ==========================================
# BlinkStream — Variables de Entorno
# Copia este archivo como .env y completa los valores
# ==========================================

# --- Supabase ---
# URL del proyecto Supabase para autenticación y backend.
# Se usa en: src/utils/supabase.js
VITE_SUPABASE_URL=https://your-project.supabase.co

# Anon (publishable) key del proyecto Supabase.
# Necesaria para que el cliente JS pueda hacer signInAnonymously()
# y enviar el JWT en cada request a las edge functions.
# Se usa en: src/utils/supabase.js
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# --- Twitch API — Client ID Público ---
# Client ID público de la aplicación Twitch (usado para consultas GQL y API pública).
# Se usa en: src/utils/twitch.js, src-tauri/src/lib.rs
VITE_TWITCH_CLIENT_ID=your_twitch_client_id_here

# --- Twitch API — Client ID de Aplicación ---
# Client ID para operaciones autenticadas con token de usuario.
# Se usa en: src/utils/twitch.js
VITE_TWITCH_APP_CLIENT_ID=your_twitch_app_client_id_here

# --- Twitch API — Client ID para Backend Rust ---
# Client ID público compilado en el backend nativo (variable de entorno en build-time).
# Se usa en: src-tauri/src/lib.rs
TWITCH_CLIENT_ID=your_twitch_client_id_here
