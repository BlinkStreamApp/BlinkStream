# ==========================================
# BlinkStream - Variables de Entorno
# Copia este archivo como .env y completa los valores
#
# Ver docs/TWITCH_APP_SETUP.md para registrar tu app Twitch propia.
# ==========================================

# --- Supabase ---
# URL del proyecto Supabase para autenticación y backend.
# Se usa en: src/utils/supabase.js
VITE_SUPABASE_URL=https://your-project.supabase.co

# Anon (publishable) key del proyecto Supabase.
# Necesaria para que el cliente JS pueda hacer signInAnonymously()
# y enviar el JWT en cada request a las edge functions.
# Se usa en: src/utils/supabase.js
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# --- Twitch API - Client ID Público (frontend) ---
# Client ID de TU APP Twitch propia (ver docs/TWITCH_APP_SETUP.md).
# Se usa en llamadas GQL (gql.twitch.tv) y en src-tauri/src/lib.rs
# (compilado en build-time desde la var TWITCH_CLIENT_ID de abajo).
# Se usa en: src/utils/twitch.js
VITE_TWITCH_CLIENT_ID=your_twitch_client_id_here

# --- Twitch API - Client ID de Aplicación (frontend, llamadas autenticadas) ---
# Por defecto, usa el mismo valor que VITE_TWITCH_CLIENT_ID.
# Se usa en: src/utils/twitch.js (cuando hay token de usuario)
VITE_TWITCH_APP_CLIENT_ID=your_twitch_app_client_id_here

# --- Twitch API - Client ID para Backend Rust (Tauri) ---
# Variable de entorno de build-time (NO prefijo VITE_).
# Se inyecta en src-tauri/src/lib.rs con la macro option_env!().
# Se usa en: src-tauri/src/lib.rs (header de gql.twitch.tv y usher.ttvnw.net)
TWITCH_CLIENT_ID=your_twitch_client_id_here

# --- Twitch API - Client Secret (SOLO backend, NUNCA frontend) ---
# ⚠️ NO va al frontend ni al binario Tauri. Solo se usa server-side.
# Configurar como secret de la Edge Function `twitch-auth` en Supabase:
#   Dashboard > Edge Functions > Secrets
# Nombre del secret: TWITCH_CLIENT_SECRET
# Ver docs/TWITCH_APP_SETUP.md sección 4.
# (Dejamos esta var comentada aquí solo como recordatorio de la nomenclatura.)
# TWITCH_CLIENT_SECRET=your_twitch_client_secret_here
