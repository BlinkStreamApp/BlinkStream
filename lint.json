red, which prevents the earlier access from updating when this value changes over time.\n\n  188 |         case 'KeyM': e.preventDefault(); toggleMute(); break\n  189 |         case 'KeyT': e.preventDefault(); onToggleTheatre?.(); break\n> 190 |         case 'KeyC': e.preventDefault(); captureScreenshot(); break\n      |                                          ^^^^^^^^^^^^^^^^^ `captureScreenshot` accessed before it is declared\n  191 |       }\n  192 |     }\n  193 |     window.addEventListener('keydown', handleKey)\n\n  241 |\n  242 |   // ─── Captura de pantalla ───────────────────────────────\n> 243 |   const captureScreenshot = async () => {\n      |   ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\n> 244 |     const video = videoRef.current\n      | ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\n> 245 |     if (!video) return\n      …\n      | ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\n> 263 |     }\n      | ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\n> 264 |   }\n      | ^^^^ `captureScreenshot` is declared here\n  265 |\n  266 |   // ─── Pop-out player ────────────────────────────────────\n  267 |   const openPopout = async () => {","line":190,"column":42,"endLine":190,"endColumn":59},{"ruleId":"react-hooks/exhaustive-deps","severity":1,"message":"React Hook useEffect has missing dependencies: 'captureScreenshot', 'onToggleTheatre', and 'toggleMute'. Either include them or remove the dependency array. If 'onToggleTheatre' changes too often, find the parent component that defines it and wrap that definition in useCallback.","line":195,"column":6,"endLine":195,"endColumn":8,"suggestions":[{"desc":"Update the dependencies array to be: [captureScreenshot, onToggleTheatre, toggleMute]","fix":{"range":[9132,9134],"text":"[captureScreenshot, onToggleTheatre, toggleMute]"}}]},{"ruleId":"react-hooks/refs","severity":2,"message":"Error: Cannot access refs during render\n\nReact refs are values that are not needed for rendering. Refs should only be accessed outside of render, such as in event handlers or effects. Accessing a ref value (the `current` property) during render can cause your component not to update as expected (https://react.dev/reference/react/useRef).\n\n  377 |             {muted ? <VolumeMute /> : <VolumeHigh />}\n  378 |           </button>\n> 379 |           <input type=\"range\" min=\"0\" max=\"100\" value={muted ? 0 : volumeRef.current} onChange={handleVolume} className=\"w-20 accent-twitch\" />\n      |                                                                    ^^^^^^^^^^^^^^^^^ Cannot access ref value during render\n  380 |\n  381 |           <div className=\"flex-1\" />\n  382 |","line":379,"column":68,"endLine":379,"endColumn":85}],"suppressedMessages":[],"errorCount":7,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { useState, useEffect, useRef, useCallback } from 'react'\nimport { invoke } from '@tauri-apps/api/core'\nimport { writeFile } from '@tauri-apps/plugin-fs'\nimport { save } from '@tauri-apps/plugin-dialog'\nimport Hls from 'hls.js'\nimport QualitySelector from './QualitySelector'\nimport { getDirectStreamUrl, getStreamInfo } from '../utils/twitch'\n\n// ─── Iconos SVG ──────────────────────────────────────────\nfunction PlayIcon() { return <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"currentColor\"><polygon points=\"8,3 20,12 8,21\"/></svg> }\nfunction PauseIcon() { return <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"currentColor\"><rect x=\"6\" y=\"3\" width=\"4\" height=\"18\"/><rect x=\"14\" y=\"3\" width=\"4\" height=\"18\"/></svg> }\nfunction VolumeHigh() { return <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M3 9v6h4l5 5V4L7 9H3zm13.5 3A4.5 4.5 0 0 0 14 8.5v7a4.49 4.49 0 0 0 2.5-3.5zM14 3.23v2.06c2.89.86 5 3.54 5 6.71s-2.11 5.85-5 6.71v2.06c4.01-.91 7-4.49 7-8.77s-2.99-7.86-7-8.77z\"/></svg> }\nfunction VolumeMute() { return <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M3 9v6h4l5 5V4L7 9H3zm13 7.24L13.76 14 16 11.76 18.24 14 20.5 11.76 22.24 14 20 16.24 22.24 18.5 20.5 20.24 18.24 18 16 20.24 14.24 18.5 16 16.24z\"/></svg> }\nfunction FullscreenIcon() { return <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M7 14H5v5h5v-2H7v-3zm-2-4h2V7h3V5H5v5zm12 7h-3v2h5v-5h-2v3zM14 5v2h3v3h2V5h-5z\"/></svg> }\nfunction PipIcon() { return <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M19 11h-8v6h8v-6zm4 8V5c0-1.1-.9-2-2-2H3c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h18c1.1 0 2-.9 2-2zm-2 0H3V5h18v14z\"/></svg> }\nfunction StarIcon({ filled }) {\n  return filled\n    ? <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z\"/></svg>\n    : <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\"><path d=\"M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z\"/></svg>\n}\nfunction ReconnectIcon() { return <svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2.5\"><polyline points=\"1 4 1 10 7 10\"/><path d=\"M3.51 15a9 9 0 1 0 2.13-9.36L1 10\"/></svg> }\nfunction TheatreIcon() { return <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\"><rect x=\"2\" y=\"3\" width=\"20\" height=\"14\" rx=\"2\"/><line x1=\"8\" y1=\"21\" x2=\"16\" y2=\"21\"/><line x1=\"12\" y1=\"17\" x2=\"12\" y2=\"21\"/></svg> }\nfunction CameraIcon() { return <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\"><path d=\"M23 7l-7 5 7 5V7z\"/><rect x=\"1\" y=\"5\" width=\"15\" height=\"14\" rx=\"2\" ry=\"2\"/></svg> }\nfunction PopoutIcon() { return <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\"><path d=\"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6\"/><polyline points=\"15 3 21 3 21 9\"/><line x1=\"10\" y1=\"14\" x2=\"21\" y2=\"3\"/></svg> }\nfunction LiveDot() { return <span className=\"w-1.5 h-1.5 rounded-full bg-red-500 animate-pulse-dot\" /> }\n\nexport default function VideoPlayer({\n  channel, quality, volume, onVolumeChange,\n  onQualityChange, onToggleFavorite, isFavorite,\n  theatreMode, onToggleTheatre,\n}) {\n  const videoRef = useRef(null)\n  const hlsRef = useRef(null)\n  const volumeRef = useRef(volume)\n  const mutedRef = useRef(false)\n  const reconnTimerRef = useRef(null)\n  const [playing, setPlaying] = useState(true)\n  const [muted, setMuted] = useState(false)\n  const [streamUrl, setStreamUrl] = useState('')\n  const [loading, setLoading] = useState(false)\n  const [error, setError] = useState('')\n  const [showControls, setShowControls] = useState(true)\n  const [availableQualities, setAvailableQualities] = useState([])\n  const [streamInfo, setStreamInfo] = useState(null)\n  const [usingFallback, setUsingFallback] = useState(false)\n  const [progress, setProgress] = useState(0)\n  const containerRef = useRef(null)\n  const controlsTimerRef = useRef(null)\n\n  // Sincronizar volumeRef con prop volume\n  useEffect(() => { volumeRef.current = volume }, [volume])\n\n  // ─── Fetch stream (Streamlink, luego fallback directo) ──\n  const fetchStream = useCallback(async (ch, qual) => {\n    if (!ch) return\n    setLoading(true)\n    setError('')\n    setStreamUrl('')\n    setUsingFallback(false)\n\n    // Intentar con Streamlink primero\n    try {\n      const url = await invoke('get_stream_url', { channel: ch, quality: qual })\n      setStreamUrl(url)\n      setLoading(false)\n      return\n    } catch (err) {\n      console.warn('Streamlink falló, usando extractor directo:', err)\n    }\n\n    // Fallback: extractor directo vía Twitch API\n    try {\n      const url = await getDirectStreamUrl(ch, qual)\n      setStreamUrl(url)\n      setUsingFallback(true)\n    } catch (err2) {\n      setError(String(err2))\n    } finally {\n      setLoading(false)\n    }\n  }, [])\n\n  // ─── Fetch qualities ───────────────────────────────────\n  const fetchQualities = useCallback(async (ch) => {\n    if (!ch) return\n    try {\n      const quals = await invoke('get_available_qualities', { channel: ch })\n      if (Array.isArray(quals) && quals.length > 0) {\n        setAvailableQualities(quals)\n        return\n      }\n    } catch { /* ignore */ }\n    // Fallback qualities\n    setAvailableQualities(['audio_only', '160p30', '360p30', '480p30', '720p60', '1080p60', 'best'])\n  }, [])\n\n  // ─── Fetch stream info ─────────────────────────────────\n  const fetchStreamInfo = useCallback(async (ch) => {\n    const info = await getStreamInfo(ch)\n    setStreamInfo(info)\n  }, [])\n\n  // ─── Load everything on channel/quality change ──────────\n  useEffect(() => {\n    fetchStream(channel, quality)\n    fetchQualities(channel)\n    fetchStreamInfo(channel)\n\n    reconnTimerRef.current = setInterval(() => {\n      fetchStream(channel, quality)\n    }, 25 * 60 * 1000) // 25 min (menos que el expiry típico de 30 min)\n\n    return () => {\n      if (reconnTimerRef.current) clearInterval(reconnTimerRef.current)\n    }\n  }, [channel, quality, fetchStream, fetchQualities, fetchStreamInfo])\n\n  useEffect(() => {\n    const interval = setInterval(() => fetchStreamInfo(channel), 120000)\n    return () => clearInterval(interval)\n  }, [channel, fetchStreamInfo])\n\n  // ─── HLS.js setup ──────────────────────────────────────\n  useEffect(() => {\n    const video = videoRef.current\n    if (!video || !streamUrl) return\n\n    if (hlsRef.current) { hlsRef.current.destroy(); hlsRef.current = null }\n\n    if (video.canPlayType('application/vnd.apple.mpegurl')) {\n      video.src = streamUrl\n    } else if (Hls.isSupported()) {\n      const hls = new Hls()\n      hlsRef.current = hls\n      hls.loadSource(streamUrl)\n      hls.attachMedia(video)\n      hls.on(Hls.Events.MANIFEST_PARSED, () => {\n        video.play().catch(() => setPlaying(false))\n      })\n      hls.on(Hls.Events.ERROR, (_e, data) => {\n        if (data.fatal) {\n          setError('Error de reproducción. Reconectando…')\n          fetchStream(channel, quality)\n        }\n      })\n    } else {\n      setError('HLS no soportado en este navegador')\n    }\n\n    return () => {\n      if (hlsRef.current) { hlsRef.current.destroy(); hlsRef.current = null }\n    }\n  }, [streamUrl, channel, quality, fetchStream])\n\n  // ─── Barra de progreso ──────────────────────────────────\n  useEffect(() => {\n    if (!streamInfo?.started_at) return\n    const started = new Date(streamInfo.started_at).getTime()\n    const update = () => setProgress(Math.floor((Date.now() - started) / 1000))\n    update()\n    const interval = setInterval(update, 1000)\n    return () => clearInterval(interval)\n  }, [streamInfo?.started_at])\n\n  function formatDuration(seconds) {\n    const h = Math.floor(seconds / 3600)\n    const m = Math.floor((seconds % 3600) / 60)\n    const s = seconds % 60\n    if (h > 0) return `${h}:${String(m).padStart(2, '0')}:${String(s).padStart(2, '0')}`\n    return `${m}:${String(s).padStart(2, '0')}`\n  }\n\n  // ─── Auto-hide controles ───────────────────────────────\n  const showControlsTemporarily = useCallback(() => {\n    setShowControls(true)\n    if (controlsTimerRef.current) clearTimeout(controlsTimerRef.current)\n    controlsTimerRef.current = setTimeout(() => setShowControls(false), 3000)\n  }, [])\n\n  // ─── Keyboard shortcuts ────────────────────────────────\n  useEffect(() => {\n    const handleKey = (e) => {\n      const el = e.target\n      if (el.tagName === 'INPUT' || el.tagName === 'TEXTAREA') return\n      switch (e.code) {\n        case 'Space': e.preventDefault(); togglePlay(); break\n        case 'KeyF': e.preventDefault(); toggleFullscreen(); break\n        case 'KeyM': e.preventDefault(); toggleMute(); break\n        case 'KeyT': e.preventDefault(); onToggleTheatre?.(); break\n        case 'KeyC': e.preventDefault(); captureScreenshot(); break\n      }\n    }\n    window.addEventListener('keydown', handleKey)\n    return () => window.removeEventListener('keydown', handleKey)\n  }, [])\n\n  const togglePlay = () => {\n    const video = videoRef.current\n    if (!video) return\n    if (video.paused) { video.play().catch(() => setPlaying(false)); setPlaying(true) }\n    else { video.pause(); setPlaying(false) }\n  }\n\n  const handleVolume = (e) => {\n    const v = Number(e.target.value)\n    volumeRef.current = v\n    mutedRef.current = v === 0\n    setMuted(v === 0)\n    onVolumeChange(v)\n    if (videoRef.current) {\n      videoRef.current.volume = v / 100\n      videoRef.current.muted = v === 0\n    }\n  }\n\n  const toggleMute = () => {\n    const video = videoRef.current\n    if (!video) return\n    const newMuted = !mutedRef.current\n    mutedRef.current = newMuted\n    setMuted(newMuted)\n    video.muted = newMuted\n    const newVol = newMuted ? 0 : volumeRef.current || 100\n    onVolumeChange(newVol)\n  }\n\n  const toggleFullscreen = () => {\n    if (!document.fullscreenElement) {\n      containerRef.current?.requestFullscreen().catch(() => {})\n    } else {\n      document.exitFullscreen().catch(() => {})\n    }\n  }\n\n  const togglePip = async () => {\n    try {\n      if (document.pictureInPictureElement) await document.exitPictureInPicture()\n      else if (videoRef.current) await videoRef.current.requestPictureInPicture()\n    } catch { /* PiP not supported */ }\n  }\n\n  // ─── Captura de pantalla ───────────────────────────────\n  const captureScreenshot = async () => {\n    const video = videoRef.current\n    if (!video) return\n    try {\n      const canvas = document.createElement('canvas')\n      canvas.width = video.videoWidth\n      canvas.height = video.videoHeight\n      const ctx = canvas.getContext('2d')\n      ctx.drawImage(video, 0, 0)\n      const blob = await new Promise(resolve => canvas.toBlob(resolve, 'image/png'))\n      if (!blob) return\n      const buffer = await blob.arrayBuffer()\n      const uint8 = new Uint8Array(buffer)\n      const filePath = await save({\n        defaultPath: `BlinkStream_${channel}_${Date.now()}.png`,\n        filters: [{ name: 'PNG Image', extensions: ['png'] }],\n      })\n      if (filePath) await writeFile(filePath, uint8)\n    } catch (err) {\n      console.warn('Screenshot failed:', err)\n    }\n  }\n\n  // ─── Pop-out player ────────────────────────────────────\n  const openPopout = async () => {\n    try {\n      const { WebviewWindow } = await import('@tauri-apps/api/webviewWindow')\n      const label = `player-${channel}-${Date.now()}`\n      const webview = new WebviewWindow(label, {\n        url: window.location.href + `?popout=${encodeURIComponent(channel)}&quality=${quality}`,\n        title: `BlinkStream - ${channel}`,\n        width: 854,\n        height: 480,\n        resizable: true,\n        decorations: true,\n      })\n      webview.once('tauri://created', () => {\n        // Disable chat in the popout somehow? For now just opens the app URL\n      })\n    } catch (err) {\n      console.warn('Pop-out not supported:', err)\n    }\n  }\n\n  const formatViewers = (n) => (!n ? null : n >= 1000 ? `${(n / 1000).toFixed(1)}k` : String(n))\n\n  return (\n    <div\n      ref={containerRef}\n      className={`relative bg-black flex flex-col min-h-0 group ${theatreMode ? 'flex-1' : 'flex-1'}`}\n      onMouseMove={showControlsTemporarily}\n      onMouseEnter={() => setShowControls(true)}\n      onMouseLeave={() => setShowControls(false)}\n    >\n      <div className=\"flex-1 relative bg-black flex items-center justify-center\">\n        {loading && (\n          <div className=\"absolute inset-0 flex items-center justify-center bg-black/60 z-10\">\n            <div className=\"flex flex-col items-center gap-3\">\n              <div className=\"w-7 h-7 border-2 border-twitch border-t-transparent rounded-full animate-spin\" />\n              <span className=\"text-xs text-white/60\">\n                {usingFallback ? 'Extrayendo stream directamente…' : `Conectando con ${channel}…`}\n              </span>\n            </div>\n          </div>\n        )}\n\n        {error && (\n          <div className=\"absolute inset-0 flex items-center justify-center bg-black/70 z-10\">\n            <div className=\"text-center px-6 max-w-sm\">\n              <p className=\"text-red-400 text-sm font-medium mb-1\">Error</p>\n              <p className=\"text-xs text-white/60 break-words mb-3\">{error}</p>\n              <button\n                onClick={() => fetchStream(channel, quality)}\n                className=\"inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-twitch hover:bg-twitch-dark text-white text-xs cursor-pointer transition-colors\"\n              >\n                <ReconnectIcon /> Reintentar\n              </button>\n            </div>\n          </div>\n        )}\n\n        <video\n          ref={videoRef}\n          className=\"w-full h-full object-contain\"\n          autoPlay={playing}\n          playsInline\n        />\n\n        {/* Overlay superior */}\n        <div className={`absolute top-0 left-0 right-0 bg-gradient-to-b from-black/70 via-black/30 to-transparent px-4 pt-3 pb-8 transition-opacity duration-300 ${showControls ? 'opacity-100' : 'opacity-0 pointer-events-none'}`}>\n          <div className=\"flex items-center gap-2 mb-1\">\n            <LiveDot />\n            <h2 className=\"text-white font-bold text-lg sm:text-xl tracking-tight drop-shadow-lg\">{channel}</h2>\n            {streamInfo?.game_name && <span className=\"text-white/50 text-xs hidden sm:inline\">• {streamInfo.game_name}</span>}\n          </div>\n          {streamInfo?.title && <p className=\"text-white/80 text-xs sm:text-sm truncate max-w-xl drop-shadow-md\">{streamInfo.title}</p>}\n          {streamInfo?.viewer_count != null && (\n            <div className=\"flex items-center gap-1 mt-1 text-white/50 text-xs drop-shadow-md\">\n              <svg width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"currentColor\" className=\"opacity-50\"><path d=\"M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z\"/></svg>\n              <span>{formatViewers(streamInfo.viewer_count)}</span>\n            </div>\n          )}\n          {usingFallback && (\n            <span className=\"inline-block mt-1 text-[10px] text-yellow-400/70 bg-yellow-400/10 px-1.5 py-0.5 rounded\">Sin Streamlink</span>\n          )}\n        </div>\n\n        {!playing && !loading && !error && (\n          <button onClick={togglePlay} className=\"absolute inset-0 flex items-center justify-center cursor-pointer bg-black/20 z-10\">\n            <div className=\"w-14 h-14 rounded-full bg-white/10 backdrop-blur-sm flex items-center justify-center hover:bg-white/20 transition-all\">\n              <PlayIcon />\n            </div>\n          </button>\n        )}\n      </div>\n\n      {/* Barra de progreso */}\n      {streamInfo?.started_at && (\n        <div className=\"shrink-0 px-3 py-1 bg-bg-secondary/20 border-t border-bg-tertiary/20 flex items-center gap-3 text-[10px] text-text-muted/60\">\n          <span className=\"shrink-0\">{formatDuration(progress)}</span>\n          <div className=\"flex-1 h-1 bg-bg-tertiary/50 rounded-full overflow-hidden\">\n            <div className=\"h-full bg-twitch/60 rounded-full transition-all duration-1000 ease-linear\" style={{ width: `${Math.min((progress / 7200) * 100, 100)}%` }} />\n          </div>\n          <span className=\"shrink-0\">En vivo</span>\n        </div>\n      )}\n\n      {/* Controles inferiores */}\n      <div className={`absolute bottom-0 left-0 right-0 bg-gradient-to-t from-black/80 via-black/40 to-transparent px-3 pb-2 pt-8 transition-opacity duration-300 ${showControls ? 'opacity-100' : 'opacity-0 pointer-events-none'}`}>\n        <div className=\"flex items-center gap-2 text-white\">\n          <button onClick={togglePlay} className=\"p-1 hover:text-twitch cursor-pointer transition-colors\" title={`${playing ? 'Pausar' : 'Reproducir'} (Space)`}>\n            {playing ? <PauseIcon /> : <PlayIcon />}\n          </button>\n          <button onClick={toggleMute} className=\"p-1 hover:text-twitch cursor-pointer transition-colors\" title={`${muted ? 'Activar' : 'Silenciar'} sonido (M)`}>\n            {muted ? <VolumeMute /> : <VolumeHigh />}\n          </button>\n          <input type=\"range\" min=\"0\" max=\"100\" value={muted ? 0 : volumeRef.current} onChange={handleVolume} className=\"w-20 accent-twitch\" />\n\n          <div className=\"flex-1\" />\n\n          <QualitySelector current={quality} onChange={onQualityChange} qualities={availableQualities} />\n          <button onClick={captureScreenshot} className=\"p-1 text-white/50 hover:text-white cursor-pointer transition-colors\" title=\"Capturar pantalla (C)\">\n            <CameraIcon />\n          </button>\n          <button onClick={onToggleFavorite} className={`p-1 cursor-pointer transition-colors ${isFavorite ? 'text-yellow-400' : 'text-white/50 hover:text-yellow-400'}`} title={isFavorite ? 'Quitar de favoritos' : 'Añadir a favoritos'}>\n            <StarIcon filled={isFavorite} />\n          </button>\n          <button onClick={togglePip} className=\"p-1 text-white/50 hover:text-white cursor-pointer transition-colors\" title=\"Picture-in-Picture\">\n            <PipIcon />\n          </button>\n          <button onClick={onToggleTheatre} className={`p-1 cursor-pointer transition-colors ${theatreMode ? 'text-twitch' : 'text-white/50 hover:text-white'}`} title=\"Modo Teatro (T)\">\n            <TheatreIcon />\n          </button>\n          <button onClick={openPopout} className=\"p-1 text-white/50 hover:text-white cursor-pointer transition-colors\" title=\"Abrir en ventana aparte\">\n            <PopoutIcon />\n          </button>\n          <button onClick={toggleFullscreen} className=\"p-1 text-white/50 hover:text-white cursor-pointer transition-colors\" title=\"Pantalla completa (F)\">\n            <FullscreenIcon />\n          </button>\n        </div>\n      </div>\n    </div>\n  )\n}\n","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\alber\\Desktop\\IA Project\\BlinkStream\\blinkstream\\src\\hooks\\useTheme.js","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\alber\\Desktop\\IA Project\\BlinkStream\\blinkstream\\src\\main.jsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\alber\\Desktop\\IA Project\\BlinkStream\\blinkstream\\src\\utils\\twitch.js","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\alber\\Desktop\\IA Project\\BlinkStream\\blinkstream\\vite.config.js","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]}]