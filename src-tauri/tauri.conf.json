{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "BlinkStream",
  "version": "1.4.1",
  "identifier": "com.blinkstream.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "BlinkStream",
        "width": 1280,
        "height": 720,
        "minWidth": 800,
        "minHeight": 480,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "devtools": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; frame-src 'self' https://oncbojnqxpxctwnhehau.supabase.co https://*.twitch.tv https://twitch.tv https://id.twitch.tv https://clips.twitch.tv https://player.twitch.tv https://*.gql.twitch.tv; child-src 'self' https://*.twitch.tv https://twitch.tv https://player.twitch.tv; worker-src 'self' blob:; connect-src 'self' http://ipc.localhost http://tauri.localhost https: wss://irc-ws.chat.twitch.tv:443 wss://irc.chat.twitch.tv:443; img-src 'self' https: data:; media-src 'self' https: blob:; font-src 'self' data:;"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "BlinkStream Team",
    "windows": {
      "nsis": {
        "installerHooks": "windows/hooks.nsh"
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "externalBin": []
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://raw.githubusercontent.com/BlinkStreamApp/BlinkStream/master/updater.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJBMzg2RUY1NjY1QTI1OQpSV1Jab21WVzc0YWpBZ1pVQm42bU5mdmdKaktGV1BpYUY3dElpeGJQelcrU2dlazZmOXI4a2liYwo=",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
