ount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { useState, useEffect, useCallback } from 'react'\nimport VideoPlayer from './components/VideoPlayer'\nimport Chat from './components/Chat'\nimport ChannelSearch from './components/ChannelSearch'\nimport Favorites from './components/Favorites'\nimport StreamInfo from './components/StreamInfo'\nimport HomeScreen from './components/HomeScreen'\nimport UpdateChecker from './components/UpdateChecker'\nimport Settings from './components/Settings'\nimport AboutDialog from './components/AboutDialog'\nimport { BlinkStreamLogo } from './components/BlinkStreamLogo'\nimport useTheme from './hooks/useTheme'\nimport { getStoredToken } from './utils/twitch'\n\n// ─── Iconos ──────────────────────────────────────────────\nfunction SunIcon() { return <svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\"><circle cx=\"12\" cy=\"12\" r=\"5\"/><path d=\"M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42\"/></svg> }\nfunction MoonIcon() { return <svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\"><path d=\"M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z\"/></svg> }\nfunction ChatIcon() { return <svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\"><path d=\"M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z\"/></svg> }\nfunction ChatOffIcon() { return <svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\"><path d=\"M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z\"/><line x1=\"2\" y1=\"2\" x2=\"22\" y2=\"22\"/></svg> }\nfunction SettingsIcon() { return <svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\"><circle cx=\"12\" cy=\"12\" r=\"3\"/><path d=\"M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z\"/></svg> }\n\nconst CHAT_BREAKPOINT = 600\nconst MAX_RECENT = 8\n\n// ─── Persistencia ────────────────────────────────────────\nfunction loadFrom(key, fallback) {\n  try {\n    const raw = localStorage.getItem(key)\n    return raw ? JSON.parse(raw) : fallback\n  } catch { return fallback }\n}\n\nfunction saveTo(key, value) {\n  try { localStorage.setItem(key, JSON.stringify(value)) } catch { /* ignore */ }\n}\n\nfunction loadFavorites() { return loadFrom('blinkstream_favorites', []).filter(f => typeof f === 'string') }\nfunction loadRecent() { return loadFrom('blinkstream_recent', []).filter(f => typeof f === 'string') }\nfunction loadVolume() { const v = Number(localStorage.getItem('blinkstream_volume')); return isNaN(v) ? 100 : v }\nfunction loadTheatre() { return localStorage.getItem('blinkstream_theatre') === 'true' }\n\nfunction App() {\n  const { resolved: theme, toggle: toggleTheme } = useTheme()\n  const [channel, setChannel] = useState('')\n  const [quality, setQuality] = useState(() => localStorage.getItem('blinkstream_quality') || 'best')\n  const [favorites, setFavorites] = useState(loadFavorites)\n  const [recentChannels, setRecentChannels] = useState(loadRecent)\n  const [volume, setVolume] = useState(loadVolume)\n  const [theatreMode, setTheatreMode] = useState(loadTheatre)\n  const [windowWidth, setWindowWidth] = useState(window.innerWidth)\n  const [showChat, setShowChat] = useState(window.innerWidth >= CHAT_BREAKPOINT)\n  const [compact, setCompact] = useState(() => localStorage.getItem('blinkstream_compact') === 'true')\n  const [showSettings, setShowSettings] = useState(false)\n  const [showAbout, setShowAbout] = useState(false)\n\n  const oauthToken = getStoredToken()\n\n  useEffect(() => {\n    const onResize = () => setWindowWidth(window.innerWidth)\n    window.addEventListener('resize', onResize)\n    return () => window.removeEventListener('resize', onResize)\n  }, [])\n\n  useEffect(() => {\n    if (windowWidth < CHAT_BREAKPOINT) setShowChat(false)\n  }, [windowWidth])\n\n  // ─── Persist effects ───\n  useEffect(() => { saveTo('blinkstream_favorites', favorites) }, [favorites])\n  useEffect(() => { saveTo('blinkstream_recent', recentChannels) }, [recentChannels])\n  useEffect(() => { localStorage.setItem('blinkstream_quality', quality) }, [quality])\n  useEffect(() => { localStorage.setItem('blinkstream_volume', String(volume)) }, [volume])\n  useEffect(() => { localStorage.setItem('blinkstream_theatre', String(theatreMode)) }, [theatreMode])\n\n  // ─── Handlers ───\n  const selectChannel = useCallback((name) => {\n    setChannel(name)\n    // Añadir a recientes (sin duplicados, al inicio)\n    setRecentChannels(prev => {\n      const filtered = prev.filter(c => c !== name)\n      return [name, ...filtered].slice(0, MAX_RECENT)\n    })\n  }, [])\n\n  const toggleFavorite = useCallback((name) => {\n    setFavorites(prev =>\n      prev.includes(name) ? prev.filter(f => f !== name) : [...prev, name]\n    )\n  }, [])\n\n  const handleQualityChange = useCallback((q) => { setQuality(q) }, [])\n\n  // Leer modo compacto al cerrar Settings\n  const handleCloseSettings = useCallback(() => {\n    setShowSettings(false)\n    setCompact(localStorage.getItem('blinkstream_compact') === 'true')\n  }, [])\n\n  return (\n    <div className={`h-screen w-screen flex flex-col bg-bg-primary text-text-primary ${theatreMode ? 'theatre-mode' : ''} ${compact ? 'compact-mode' : ''}`}>\n      {/* ─── Header ─── */}\n      {!theatreMode && (\n        <header className=\"flex items-center gap-2 px-3 py-1.5 bg-bg-secondary/80 backdrop-blur-sm border-b border-bg-tertiary/50 shrink-0 select-none\">\n          <div className=\"flex items-center gap-2 mr-1 cursor-pointer\" onClick={() => { if (channel) setChannel('') }} title={channel ? 'Volver al inicio' : 'BlinkStream'}>\n            <BlinkStreamLogo size={22} />\n            <span className=\"text-sm font-bold text-twitch tracking-tight hidden sm:inline\">BlinkStream</span>\n          </div>\n          <div className=\"w-px h-5 bg-bg-tertiary mx-1\" />\n          <ChannelSearch onSelect={selectChannel} currentChannel={channel} />\n          <Favorites favorites={favorites} onSelect={selectChannel} current={channel} />\n          <div className=\"flex-1\" />\n          <div className=\"flex items-center gap-1\">\n            <button\n              onClick={() => setShowSettings(true)}\n              className=\"p-1.5 rounded-md text-text-muted hover:text-text-primary hover:bg-hover cursor-pointer transition-colors\"\n              title=\"Configuración\"\n            >\n              <SettingsIcon />\n            </button>\n            <button\n              onClick={toggleTheme}\n              className=\"p-1.5 rounded-md text-text-muted hover:text-text-primary hover:bg-hover cursor-pointer transition-colors\"\n              title={theme === 'dark' ? 'Modo claro' : 'Modo oscuro'}\n            >\n              {theme === 'dark' ? <SunIcon /> : <MoonIcon />}\n            </button>\n            {channel && (\n              <button\n                onClick={() => setShowChat(p => !p)}\n                className=\"p-1.5 rounded-md text-text-muted hover:text-text-primary hover:bg-hover cursor-pointer transition-colors\"\n                title={showChat ? 'Ocultar chat' : 'Mostrar chat'}\n              >\n                {showChat ? <ChatIcon /> : <ChatOffIcon />}\n              </button>\n            )}\n          </div>\n        </header>\n      )}\n\n      {/* ─── Contenido principal ─── */}\n      <div className=\"flex flex-1 min-h-0\">\n        <div className={`flex flex-col ${showChat && !theatreMode ? 'flex-1' : 'w-full'}`}>\n          {channel ? (\n            <>\n              {!theatreMode && <StreamInfo channel={channel} />}\n              <VideoPlayer\n                channel={channel}\n                quality={quality}\n                volume={volume}\n                onVolumeChange={setVolume}\n                onQualityChange={handleQualityChange}\n                onToggleFavorite={() => toggleFavorite(channel)}\n                isFavorite={favorites.includes(channel)}\n                theatreMode={theatreMode}\n                onToggleTheatre={() => setTheatreMode(p => !p)}\n              />\n            </>\n          ) : (\n            <HomeScreen\n              onSelect={selectChannel}\n              favorites={favorites}\n              recentChannels={recentChannels}\n              onShowAbout={() => setShowAbout(true)}\n            />\n          )}\n        </div>\n\n        {showChat && channel && !theatreMode && (\n          <div className=\"w-80 min-w-[280px] max-w-[400px] border-l border-bg-tertiary/50\">\n            <Chat channel={channel} />\n          </div>\n        )}\n      </div>\n\n      <UpdateChecker />\n      {showSettings && <Settings onClose={handleCloseSettings} />}\n      {showAbout && <AboutDialog onClose={() => setShowAbout(false)} />}\n    </div>\n  )\n}\n\nexport default App\n","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\alber\\Desktop\\IA Project\\BlinkStream\\blinkstream\\src\\components\\AboutDialog.jsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\alber\\Desktop\\IA Project\\BlinkStream\\blinkstream\\src\\components\\BlinkStreamLogo.jsx","messages":[{"ruleId":"no-unused-vars","severity":2,"message":"'logoImg' is defined but never used.","line":10,"column":8,"messageId":"unusedVar","endLine":10,"endColumn":15,"suggestions":[{"messageId":"removeVar","data":{"varName":"logoImg"},"fix":{"range":[253,266],"text":""},"desc":"Remove unused variable 'logoImg'."}]}],"suppressedMessages":[],"errorCount":1,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"/**\n * BlinkStreamLogo — Logo minimalista SVG\n * \n * Diseño moderno que combina:\n * - Círculo con gradiente (representa la señal/stream)\n * - Triángulo de reproducción (stream)\n * - Línea de \"parpadeo\" (blink)\n * - Arcos de señal (broadcast)\n */\nimport logoImg from '../assets/BlinkStreamLogo.png'\n\nexport function BlinkStreamLogo({ size = 28, className = '' }) {\n  return (\n    <svg\n      width={size}\n      height={size}\n      viewBox=\"0 0 32 32\"\n      fill=\"none\"\n      className={`shrink-0 ${className}`}\n      aria-label=\"BlinkStream\"\n    >\n      <defs>\n        <linearGradient id=\"bs-grad\" x1=\"0\" y1=\"0\" x2=\"32\" y2=\"32\">\n          <stop offset=\"0%\" stopColor=\"#A970FF\" />\n          <stop offset=\"100%\" stopColor=\"#772CE8\" />\n        </linearGradient>\n      </defs>\n\n      {/* Fondo circular con gradiente */}\n      <circle cx=\"16\" cy=\"16\" r=\"16\" fill=\"url(#bs-grad)\" />\n\n      {/* Señal de broadcast — arcos exteriores sutiles */}\n      <path d=\"M9 9.5A9.5 9.5 0 0 1 23 9.5\" stroke=\"white\" strokeWidth=\"1.2\" strokeLinecap=\"round\" opacity=\"0.25\" />\n      <path d=\"M11 12A6.5 6.5 0 0 1 21 12\" stroke=\"white\" strokeWidth=\"1.2\" strokeLinecap=\"round\" opacity=\"0.35\" />\n\n      {/* Triángulo de play (stream) */}\n      <path d=\"M13.5 9.5L23 16L13.5 22.5Z\" fill=\"white\" />\n\n      {/* Línea de \"parpadeo\" (blink) — offset a la izquierda */}\n      <line x1=\"9\" y1=\"15.5\" x2=\"14\" y2=\"15.5\" stroke=\"white\" strokeWidth=\"1.8\" strokeLinecap=\"round\" opacity=\"0.55\" />\n    </svg>\n  )\n}\n\n/**\n * Logotipo completo con icono SVG + texto\n */\nexport function BlinkStreamFull({ size = 28, showTagline = false }) {\n  return (\n    <div className=\"flex items-center gap-2\">\n      <span style={{ lineHeight: 0 }}>\n        <BlinkStreamLogo size={size} />\n      </span>\n      <div className=\"flex flex-col leading-tight\">\n        <span\n          className=\"font-bold text-text-primary tracking-tight\"\n          style={{ fontSize: size * 0.65 }}\n        >\n          BlinkStream\n        </span>\n        {showTagline && (\n          <span className=\"text-[10px] text-text-muted font-normal tracking-normal\">\n            Twitch sin anuncios\n          </span>\n        )}\n      </div>\n    </div>\n  )\n}\n\nexport default BlinkStreamLogo\n","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\alber\\Desktop\\IA Project\\BlinkStream\\blinkstream\\src\\components\\ChannelSearch.jsx","messages":[{"ruleId":"react-hooks/set-state-in-effect","severity":2,"message":"Error: Calling setState synchronously within an effect can trigger cascading renders\n\nEffects are intended to synchronize state between React and external systems such as manually updating the DOM, state management libraries, or other platform APIs. In general, the body of an effect should do one or both of the following:\n* Update external systems with the latest state from React.\n* Subscribe for updates from some external system, calling setState in a callback function when external state changes.\n\nCalling setState synchronously within an effect body causes cascading renders that can hurt performance, and is not recommended. (https://react.dev/learn/you-might-not-need-an-effect).\n\n  27 |   // Clear on channel change\n  28 |   useEffect(() => {\n> 29 |     if (currentChannel) { setInput(''); setSuggestions([]) }\n     |                           ^^^^^^^^ Avoid calling setState() directly within an effect\n  30 |   }, [currentChannel])\n  31 |\n  32 |   // Autocomplete debounced","line":29,"column":27,"endLine":29,"endColumn":35},{"ruleId":"react-hooks/set-state-in-effect","severity":2,"message":"Error: Calling setState synchronously within an effect can trigger cascading renders\n\nEffects are intended to synchronize state between React and external systems such as manually updating the DOM, state management libraries, or other platform APIs. In general, the body of an effect should do one or both of the following:\n* Update external systems with the latest state from React.\n* Subscribe for updates from some external system, calling setState in a callback function when external state changes.\n\nCalling setState synchronously within an effect body causes cascading renders that can hurt performance, and is not recommended. (https://react.dev/learn/you-might-not-need-an-effect).\n\n  34 |     if (debounceRef.current) clearTimeout(debounceRef.current)\n  35 |     const val = input.trim()\n> 36 |     if (val.length < 2) { setSuggestions([]); return }\n     |                           ^^^^^^^^^^^^^^ Avoid calling setState() directly within an effect\n  37 |\n  38 |     debounceRef.current = setTimeout(async () => {\n  39 |       try {","line":36,"column":27,"endLine":36,"endColumn":41}],"suppressedMessages":[],"errorCount":2,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { useState, useEffect, useRef, useCallback } from 'react'\nimport { searchChannels } from '../utils/twitch'\n\nconst CHANNEL_RE = /^[a-zA-Z][a-zA-Z0-9_]{2,24}$/\n\nexport default function ChannelSearch({ onSelect, currentChannel }) {\n  const [input, setInput] = useState('')\n  const [error, setError] = useState('')\n  const [suggestions, setSuggestions] = useState([])\n  const [showSuggestions, setShowSuggestions] = useState(false)\n  const [selectedIdx, setSelectedIdx] = useState(-1)\n  const inputRef = useRef(null)\n  const debounceRef = useRef(null)\n  const containerRef = useRef(null)\n\n  // Ctrl+K focus\n  useEffect(() => {\n    const handleKey = (e) => {\n      if ((e.ctrlKey || e.metaKey) && e.code === 'KeyK') {\n        e.preventDefault(); inputRef.current?.focus()\n      }\n    }\n    window.addEventListener('keydown', handleKey)\n    return () => window.removeEventListener('keydown', handleKey)\n  }, [])\n\n  // Clear on channel change\n  useEffect(() => {\n    if (currentChannel) { setInput(''); setSuggestions([]) }\n  }, [currentChannel])\n\n  // Autocomplete debounced\n  useEffect(() => {\n    if (debounceRef.current) clearTimeout(debounceRef.current)\n    const val = input.trim()\n    if (val.length < 2) { setSuggestions([]); return }\n\n    debounceRef.current = setTimeout(async () => {\n      try {\n        const results = await searchChannels(val)\n        setSuggestions(results.filter(r => r.login !== currentChannel).slice(0, 6))\n        setShowSuggestions(true)\n        setSelectedIdx(-1)\n      } catch { setSuggestions([]) }\n    }, 250)\n\n    return () => { if (debounceRef.current) clearTimeout(debounceRef.current) }\n  }, [input, currentChannel])\n\n  // Close suggestions on outside click\n  useEffect(() => {\n    const handleClick = (e) => {\n      if (containerRef.current && !containerRef.current.contains(e.target)) setShowSuggestions(false)\n    }\n    document.addEventListener('mousedown', handleClick)\n    return () => document.removeEventListener('mousedown', handleClick)\n  }, [])\n\n  const selectChannel = useCallback((name) => {\n    setError('')\n    setInput('')\n    setSuggestions([])\n    setShowSuggestions(false)\n    onSelect(name)\n    inputRef.current?.blur()\n  }, [onSelect])\n\n  const handleSubmit = (e) => {\n    e.preventDefault()\n    const name = input.trim().toLowerCase()\n    if (!name) { setError('Introduce un nombre de canal'); return }\n    if (!CHANNEL_RE.test(name)) { setError('Nombre inválido (3-25 chars, letras/números/_)'); return }\n    selectChannel(name)\n  }\n\n  const handleKeyDown = (e) => {\n    if (!showSuggestions || !suggestions.length) return\n    switch (e.key) {\n      case 'ArrowDown': e.preventDefault(); setSelectedIdx(i => Math.min(i + 1, suggestions.length - 1)); break\n      case 'ArrowUp': e.preventDefault(); setSelectedIdx(i => Math.max(i - 1, 0)); break\n      case 'Enter':\n        if (selectedIdx >= 0) { e.preventDefault(); selectChannel(suggestions[selectedIdx].login) }\n        break\n      case 'Escape': setShowSuggestions(false); break\n    }\n  }\n\n  return (\n    <div className=\"flex-1 max-w-xs relative\" ref={containerRef}>\n      <form onSubmit={handleSubmit} onKeyDown={handleKeyDown}>\n        <svg className=\"absolute left-2.5 top-1/2 -translate-y-1/2 text-text-muted/50 pointer-events-none\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2.5\">\n          <circle cx=\"11\" cy=\"11\" r=\"8\"/><path d=\"m21 21-4.35-4.35\"/>\n        </svg>\n        <input\n          ref={inputRef}\n          type=\"text\"\n          value={input}\n          onChange={(e) => { setInput(e.target.value); setError('') }}\n          onFocus={() => suggestions.length > 0 && setShowSuggestions(true)}\n          placeholder=\"Buscar canal…\"\n          maxLength={25}\n          className=\"w-full pl-8 pr-3 py-1.5 rounded-lg bg-bg-tertiary/60 text-text-primary placeholder-text-muted/40 text-sm border border-transparent focus:border-twitch/50 focus:bg-bg-tertiary focus:outline-none transition-all\"\n          aria-label=\"Buscar canal de Twitch\"\n          autoComplete=\"off\"\n        />\n        {error && <span className=\"absolute -bottom-4.5 left-0 text-red-400/80 text-[10px] whitespace-nowrap\">{error}</span>}\n      </form>\n\n      {/* Dropdown sugerencias */}\n      {showSuggestions && suggestions.length > 0 && (\n        <div className=\"absolute top-full mt-1.5 left-0 right-0 bg-bg-secondary border border-bg-tertiary/50 rounded-xl shadow-2xl z-50 py-1 overflow-hidden\">\n          {suggestions.map((s, i) => (\n            <button\n              key={s.login}\n              onClick={() => selectChannel(s.login)}\n              className={`flex items-center gap-2.5 w-full px-3 py-2 text-sm text-left cursor-pointer transition-colors ${\n                i === selectedIdx ? 'bg-twitch/20 text-twitch' : 'hover:bg-hover text-text-primary'\n              }`}\n              onMouseEnter={() => setSelectedIdx(i)}\n            >\n              {s.avatar ? (\n                <img src={s.avatar.replace('{width}', '40').replace('{height}', '40')} alt=\"\" className=\"w-7 h-7 rounded-full\" loading=\"lazy\" />\n              ) : (\n                <div className=\"w-7 h-7 rounded-full bg-bg-tertiary flex items-center justify-center text-xs text-text-muted\">?</div>\n              )}\n              <div className=\"flex-1 min-w-0\">\n                <div className=\"font-medium truncate\">{s.displayName || s.login}</div>\n                <div className=\"text-[10px] text-text-muted/60 truncate\">\n                  {s.isLive ? `🔴 ${s.game || 'En vivo'} · ${s.viewers ? `${(s.viewers/1000).toFixed(1)}k` : ''}` : 'Sin stream'}\n                </div>\n              </div>\n              {s.isLive && <span className=\"w-1.5 h-1.5 rounded-full bg-red-500 shrink-0 animate-pulse-dot\" />}\n            </button>\n          ))}\n        </div>\n      )}\n    </div>\n  )\n}\n","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\alber\\Desktop\\IA Project\\BlinkStream\\blinkstream\\src\\components\\Chat.jsx","messages":[{"ruleId":"react-hooks/set-state-in-effect","severity":2,"message":"Error: Calling setState synchronously within an effect can trigger cascading renders\n\nEffects are intended to synchronize state between React and external systems such as manually updating the DOM, state management libraries, or other platform APIs. In general, the body of an effect should do one or both of the following:\n* Update external systems with the latest state from React.\n* Subscribe for updates from some external system, calling setState in a callback function when external state changes.\n\nCalling setState synchronously within an effect body causes cascading renders that can hurt performance, and is not recommended. (https://react.dev/learn/you-might-not-need-an-effect).\n\n  269 |   useEffect(() => {\n  270 |     if (!channel) return\n> 271 |     loadEmotes(channel)\n      |     ^^^^^^^^^^ Avoid calling setState() directly within an effect\n  272 |   }, [channel, loadEmotes])\n  273 |\n  274 |   // Resolve badges","line":271,"column":5,"endLine":271,"endColumn":15},{"ruleId":"no-unused-vars","severity":2,"message":"'verification_uri' is assigned a value but never used.","line":388,"column":39,"messageId":"unusedVar","endLine":388,"endColumn":55,"suggestions":[{"messageId":"removeVar","data":{"varName":"verification_uri"},"fix":{"range":[12833,12851],"text":""},"desc":"Remove unused variable 'verification_uri'."}]},{"ruleId":"react-hooks/set-state-in-effect","severity":2,"message":"Error: Calling setState synchronously within an effect can trigger cascading renders\n\nEffects are intended to synchronize state between React and external systems such as manually updating the DOM, state management libraries, or other platform APIs. In general, the body of an effect should do one or both of the following:\n* Update external systems with the latest state from React.\n* Subscribe for updates from some external system, calling setState in a callback function when external state changes.\n\nCalling setState synchronously within an effect body causes cascading renders that can hurt performance, and is not recommended. (https://react.dev/learn/you-might-not-need-an-effect).\n\n  471 |     let retryDelay = 1000\n  472 |     const MAX_RETRY = 30000\n> 473 |     setConnError('')\n      |     ^^^^^^^^^^^^ Avoid calling setState() directly within an effect\n  474 |     lineBufferRef.current = ''\n  475 |\n  476 |     const connect = () => {","line":473,"column":5,"endLine":473,"endColumn":17},{"ruleId":"no-unused-vars","severity":2,"message":"'reconnectTimer' is assigned a value but never used.","line":480,"column":11,"messageId":"unusedVar","endLine":480,"endColumn":25},{"ruleId":"react-hooks/refs","severity":2,"message":"Error: Cannot access refs during render\n\nReact refs are values that are not needed for rendering. Refs should only be accessed outside of render, such as in event handlers or effects. Accessing a ref value (the `current` property) during render can cause your component not to update as expected (https://react.dev/reference/react/useRef).\n\n  811 |\n  812 |         <div className=\"space-y-0.5\">\n> 813 |           {messages.map(msg => (\n      |                         ^^^^^^^^\n> 814 |             <div\n      | ^^^^^^^^^^^^^^^^\n> 815 |               key={msg.id}\n      …\n      | ^^^^^^^^^^^^^^^^\n> 835 |             </div>\n      | ^^^^^^^^^^^^^^^^\n> 836 |           ))}\n      | ^^^^^^^^^^^^ Cannot access ref value during render\n  837 |         </div>\n  838 |\n  839 |         <div ref={bottomRef} />","line":813,"column":25,"endLine":836,"endColumn":12}],"suppressedMessages":[],"errorCount":5,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { useState, useEffect, useRef, useCallback } from 'react'\n\n// Client-ID por defecto (público, de Twitch web)\n// Usuarios avanzados pueden configurar su propio Client-ID\n// registrando una app en https://dev.twitch.tv/console/apps\nconst DEFAULT_CLIENT_ID = 'kimne78kx3ncx6brgo4mv6wki5h1ko'\n\nfunction loadCustomClientId() {\n  try { return localStorage.getItem('blinkstream_custom_client_id') || '' } catch { return '' }\n}\nfunction saveCustomClientId(id) {\n  try { localStorage.setItem('blinkstream_custom_client_id', id || '') } catch { /* ignore */ }\n}\n\nconst EMOTE_RE = /^(\\w+)$/\n\nfunction parseMessageTags(tags) {\n  const obj = {}\n  tags.split(';').forEach(pair => {\n    const [k, v] = pair.split('=')\n    if (k) obj[k] = v || ''\n  })\n  return obj\n}\n\n// Build a trie for efficient emote matching\nfunction buildEmoteTrie(emotes) {\n  const root = {}\n  for (const [code, data] of Object.entries(emotes)) {\n    if (!EMOTE_RE.test(code)) continue\n    let node = root\n    for (const ch of code) {\n      if (!node[ch]) node[ch] = {}\n      node = node[ch]\n    }\n    node.$ = data\n  }\n  return root\n}\n\nfunction matchEmotesInText(text, twitchEmotesStr, trie) {\n  const emoteMap = {}\n  if (twitchEmotesStr) {\n    twitchEmotesStr.split('/').forEach(pair => {\n      const [id, positions] = pair.split(':')\n      if (id && positions) {\n        positions.split(',').forEach(range => {\n          const [start, end] = range.split('-')\n          emoteMap[Number(start)] = { id, start: Number(start), end: Number(end) + 1 }\n        })\n      }\n    })\n  }\n\n  const parts = []\n  let i = 0\n  while (i < text.length) {\n    if (emoteMap[i]) {\n      const em = emoteMap[i]\n      parts.push({ type: 'twitch-emote', id: em.id, text: text.slice(em.start, em.end) })\n      i = em.end\n      continue\n    }\n\n    let node = trie\n    let matchedCode = null\n    let matchedData = null\n    for (let j = i; j < text.length && node[text[j]]; j++) {\n      node = node[text[j]]\n      if (node.$) {\n        matchedCode = text.slice(i, j + 1)\n        matchedData = node.$\n      }\n    }\n    if (matchedCode) {\n      parts.push({ type: 'third-party-emote', urls: matchedData.urls, name: matchedCode })\n      i += matchedCode.length\n      continue\n    }\n\n    let textStart = i\n    while (i < text.length && !emoteMap[i]) {\n      let node2 = trie\n      let couldBeEmote = false\n      for (let j = i; j < text.length && node2[text[j]]; j++) {\n        node2 = node2[text[j]]\n        if (node2.$) { couldBeEmote = true; break }\n      }\n      if (couldBeEmote && emoteMap[i]) break\n      if (couldBeEmote) {\n        let n = trie\n        let match = false\n        for (let j = i; j < text.length && n[text[j]]; j++) {\n          n = n[text[j]]\n          if (n.$) { match = true; break }\n        }\n        if (match) break\n      }\n      i++\n    }\n    if (i > textStart) {\n      parts.push({ type: 'text', text: text.slice(textStart, i) })\n    }\n  }\n  return parts\n}\n\n// Badge cache\nconst badgeCache = { global: null }\n\nasync function getBadgeUrl(setName, version) {\n  try {\n    if (!badgeCache.global) {\n      const res = await fetch('https://badges.twitch.tv/v1/badges/global/display', { signal: AbortSignal.timeout(5000) })\n      if (res.ok) {\n        const data = await res.json()\n        badgeCache.global = data.badge_sets || {}\n      }\n    }\n    const setData = badgeCache.global?.[setName]\n    return setData?.versions?.[version]?.image_url_1x || null\n  } catch {\n    return null\n  }\n}\n\nfunction loadAuth() {\n  try {\n    const token = localStorage.getItem('blinkstream_twitch_token')\n    const username = localStorage.getItem('blinkstream_twitch_username')\n    return { token, username }\n  } catch { return { token: null, username: null } }\n}\n\nfunction saveAuth(token, username) {\n  try {\n    localStorage.setItem('blinkstream_twitch_token', token || '')\n    localStorage.setItem('blinkstream_twitch_username', username || '')\n  } catch { /* ignore */ }\n}\n\nfunction clearAuth() {\n  try {\n    localStorage.removeItem('blinkstream_twitch_token')\n    localStorage.removeItem('blinkstream_twitch_username')\n  } catch { /* ignore */ }\n}\n\nexport default function Chat({ channel }) {\n  const [messages, setMessages] = useState([])\n  const [emotes, setEmotes] = useState({})\n  const [badgeUrls, setBadgeUrls] = useState({})\n  const [connected, setConnected] = useState(false)\n  const [connError, setConnError] = useState('')\n  const [inputText, setInputText] = useState('')\n  const [newMsgCount, setNewMsgCount] = useState(0)\n  const [auth, setAuth] = useState(loadAuth)\n  const [authing, setAuthing] = useState(false)\n  const [authCode, setAuthCode] = useState('')\n  const [authError, setAuthError] = useState('')\n  const [showLoginOptions, setShowLoginOptions] = useState(false)\n  const [manualToken, setManualToken] = useState('')\n  const [customClientId, setCustomClientId] = useState(loadCustomClientId)\n  const [showAdvanced, setShowAdvanced] = useState(false)\n\n  const bottomRef = useRef(null)\n  const containerRef = useRef(null)\n  const isAtBottomRef = useRef(true)\n  const wsRef = useRef(null)\n  const lineBufferRef = useRef('')\n  const trieRef = useRef({})\n\n  useEffect(() => {\n    trieRef.current = buildEmoteTrie(emotes)\n  }, [emotes])\n\n  const handleScroll = useCallback(() => {\n    const el = containerRef.current\n    if (!el) return\n    const threshold = 100\n    isAtBottomRef.current = el.scrollHeight - el.scrollTop - el.clientHeight < threshold\n    if (isAtBottomRef.current) setNewMsgCount(0)\n  }, [])\n\n  const scrollToBottom = useCallback(() => {\n    bottomRef.current?.scrollIntoView({ behavior: 'smooth' })\n    setNewMsgCount(0)\n  }, [])\n\n  const renderMessage = useCallback((text, twitchEmotes) => {\n    if (!text) return text\n    const parts = matchEmotesInText(text, twitchEmotes, trieRef.current)\n    return parts.map((part, idx) => {\n      if (part.type === 'text') return part.text\n      if (part.type === 'twitch-emote') {\n        return (\n          <img key={idx} src={`https://static-cdn.jtvnw.net/emoticons/v2/${part.id}/default/dark/2.0`} alt={part.text} className=\"inline-block w-6 h-6 align-middle\" loading=\"lazy\" />\n        )\n      }\n      return (\n        <img key={idx} src={part.urls?.[2] || part.urls?.[1] || part.urls?.[0]} alt={part.name} className=\"inline-block w-6 h-6 align-middle\" loading=\"lazy\" />\n      )\n    })\n  }, [])\n\n  const loadEmotes = useCallback(async (channelName) => {\n    const dict = {}\n    const controllers = []\n\n    const fetchJson = async (url, timeout = 5000) => {\n      const ac = new AbortController()\n      controllers.push(ac)\n      const res = await fetch(url, { signal: AbortSignal.timeout(timeout) })\n      return res.ok ? res.json() : null\n    }\n\n    try {\n      const data = await fetchJson(`https://api.7tv.app/v2/users/${channelName}/emotes`)\n      if (data) data.forEach(e => { dict[e.code] = { urls: [`https://cdn.7tv.app/emote/${e.id}/1x`, `https://cdn.7tv.app/emote/${e.id}/2x`, `https://cdn.7tv.app/emote/${e.id}/3x`] } })\n    } catch { /* ignore */ }\n\n    try {\n      const data = await fetchJson(`https://api.betterttv.net/3/cached/users/twitch/${channelName}`)\n      if (data) {\n        ;[...(data.channelEmotes || []), ...(data.sharedEmotes || [])].forEach(e => {\n          dict[e.code] = { urls: [`https://cdn.betterttv.com/emote/${e.id}/1x`, `https://cdn.betterttv.com/emote/${e.id}/2x`, `https://cdn.betterttv.com/emote/${e.id}/3x`] }\n        })\n      }\n    } catch { /* ignore */ }\n\n    try {\n      const data = await fetchJson('https://api.betterttv.net/3/cached/emotes/global')\n      if (data) {\n        data.forEach(e => {\n          if (!dict[e.code]) dict[e.code] = { urls: [`https://cdn.betterttv.com/emote/${e.id}/1x`, `https://cdn.betterttv.com/emote/${e.id}/2x`, `https://cdn.betterttv.com/emote/${e.id}/3x`] }\n        })\n      }\n    } catch { /* ignore */ }\n\n    try {\n      const data = await fetchJson(`https://api.frankerfacez.com/v1/room/${channelName}`)\n      if (data) {\n        const sets = data.sets || {}\n        Object.values(sets).forEach(set => {\n          (set.emoticons || []).forEach(e => {\n            const url = e.urls?.[4] || e.urls?.[2] || e.urls?.[1]\n            if (url && !dict[e.name]) dict[e.name] = { urls: [url] }\n          })\n        })\n      }\n    } catch { /* ignore */ }\n\n    try {\n      const data = await fetchJson('https://api.frankerfacez.com/v1/set/global')\n      if (data) {\n        const sets = data.sets || {}\n        Object.values(sets).forEach(set => {\n          (set.emoticons || []).forEach(e => {\n            const url = e.urls?.[4] || e.urls?.[2] || e.urls?.[1]\n            if (url && !dict[e.name]) dict[e.name] = { urls: [url] }\n          })\n        })\n      }\n    } catch { /* ignore */ }\n\n    setEmotes(dict)\n  }, [])\n\n  useEffect(() => {\n    if (!channel) return\n    loadEmotes(channel)\n  }, [channel, loadEmotes])\n\n  // Resolve badges\n  useEffect(() => {\n    if (!messages.length) return\n    const lastMsg = messages[messages.length - 1]\n    const pendingBadges = lastMsg.badges.filter(b => !badgeUrls[`${lastMsg.id}-${b.set}`])\n    if (!pendingBadges.length) return\n\n    Promise.all(pendingBadges.map(b =>\n      getBadgeUrl(b.set, b.version).then(url => ({ key: `${lastMsg.id}-${b.set}`, url }))\n    )).then(results => {\n      const updates = {}\n      results.forEach(r => { if (r.url) updates[r.key] = r.url })\n      if (Object.keys(updates).length) setBadgeUrls(prev => ({ ...prev, ...updates }))\n    })\n  }, [messages, badgeUrls])\n\n  // ─── Twitch Login (Auth Directo) ────────────────────────────\n  // Obtener el Client-ID actual (custom si el usuario configuró uno)\n  const getClientId = useCallback(() => customClientId || DEFAULT_CLIENT_ID, [customClientId])\n\n  // URL del generador de token (Edge Function en Supabase)\n  const AUTH_URL = 'https://dmclksrlxlfodjestndf.supabase.co/functions/v1/twitch-auth'\n  const [copiedUrl, setCopiedUrl] = useState(false)\n\n  // Copiar URL al portapapeles\n  const handleOpenTokenSite = useCallback(async () => {\n    try {\n      await navigator.clipboard.writeText(AUTH_URL)\n      setCopiedUrl(true)\n      setTimeout(() => setCopiedUrl(false), 3000)\n    } catch (err) {\n      console.warn('[Auth] Error copiando URL:', err)\n    }\n  }, [])\n\n  // Validar y guardar el token pegado manualmente\n  const handleManualTokenSubmit = useCallback(async () => {\n    const raw = manualToken.trim()\n    if (!raw) return\n\n    setAuthing(true)\n    setAuthError('')\n\n    // Limpiar prefijo \"oauth:\" si viene incluido\n    const cleanToken = raw.replace(/^oauth:/i, '')\n\n    try {\n      const clientId = getClientId()\n      // Validar token contra la API de Twitch\n      const res = await fetch('https://api.twitch.tv/helix/users', {\n        headers: {\n          'Authorization': `Bearer ${cleanToken}`,\n          'Client-ID': clientId,\n        },\n      })\n\n      if (!res.ok) {\n        const errData = await res.json().catch(() => ({}))\n        throw new Error(errData.message || `Token inválido (HTTP ${res.status})`)\n      }\n\n      const data = await res.json()\n      const username = data.data?.[0]?.login\n\n      if (!username) {\n        throw new Error('No se pudo obtener el nombre de usuario')\n      }\n\n      saveAuth(cleanToken, username)\n      setAuth({ token: cleanToken, username })\n      setShowLoginOptions(false)\n      setManualToken('')\n      setAuthError('')\n    } catch (err) {\n      console.warn('Token validation error:', err)\n      // Si el error es de Client-ID, sugerir configurar uno propio\n      if (err.message?.includes('Invalid client') || err.message?.includes('403')) {\n        setAuthError(`Token rechazado (${err.message}). Si usas un token de otro generador, configura tu propio Client-ID en \"Avanzado\".`)\n      } else {\n        setAuthError(err.message)\n      }\n    } finally {\n      setAuthing(false)\n    }\n  }, [manualToken, getClientId])\n\n  // Opción 2: Device Code Flow (no necesita redirect URI)\n  const handleDeviceCodeLogin = useCallback(async () => {\n    setAuthing(true)\n    setAuthCode('')\n    setAuthError('')\n    setShowLoginOptions(false)\n    try {\n      const clientId = getClientId()\n      console.log('[Auth] Solicitando device code con Client-ID:', clientId)\n\n      const deviceRes = await fetch('https://id.twitch.tv/oauth2/device', {\n        method: 'POST',\n        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },\n        body: new URLSearchParams({\n          client_id: clientId,\n          scopes: 'chat:read chat:edit',\n        }),\n      })\n\n      if (!deviceRes.ok) {\n        const errText = await deviceRes.text().catch(() => '')\n        console.warn('[Auth] Device code error:', deviceRes.status, errText)\n        throw new Error(\n          `Error de autenticación (${deviceRes.status}). Usa \"Token manual\" como alternativa.`\n        )\n      }\n\n      const deviceData = await deviceRes.json()\n      const { device_code, user_code, verification_uri } = deviceData\n      const interval = Number(deviceData.interval) || 5\n\n      console.log('[Auth] Device code obtenido. Código:', user_code)\n\n      setAuthCode(user_code)\n\n      // Polling hasta que el usuario autorice\n      let pollInterval = interval * 1000\n      let attempts = 0\n      const MAX_ATTEMPTS = 60\n\n      while (attempts < MAX_ATTEMPTS) {\n        await new Promise(r => setTimeout(r, pollInterval))\n        attempts++\n\n        const tokenRes = await fetch('https://id.twitch.tv/oauth2/token', {\n          method: 'POST',\n          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },\n          body: new URLSearchParams({\n            client_id: clientId,\n            device_code,\n            grant_type: 'urn:ietf:params:oauth:grant-type:device_code',\n          }),\n        })\n\n        const tokenData = await tokenRes.json()\n\n        if (tokenData.access_token) {\n          const cleanToken = tokenData.access_token\n          saveAuth(cleanToken, null)\n          setAuth({ token: cleanToken, username: null })\n\n          try {\n            const userRes = await fetch('https://api.twitch.tv/helix/users', {\n              headers: {\n                'Authorization': `Bearer ${cleanToken}`,\n                'Client-ID': clientId,\n              },\n            })\n            if (userRes.ok) {\n              const userData = await userRes.json()\n              const username = userData.data?.[0]?.login\n              if (username) {\n                saveAuth(cleanToken, username)\n                setAuth({ token: cleanToken, username })\n              }\n            }\n          } catch { /* ignore */ }\n\n          setAuthing(false)\n          setAuthCode('')\n          return\n        }\n\n        if (tokenData.error === 'authorization_pending') continue\n        if (tokenData.error === 'slow_down') { pollInterval += 5000; continue }\n        if (tokenData.error === 'expired_token') {\n          throw new Error('El código expiró. Intenta de nuevo.')\n        }\n\n        console.warn('[Auth] Device poll error:', tokenData)\n        throw new Error(tokenData.message || 'Error durante la autenticación')\n      }\n\n      throw new Error('Tiempo de espera agotado. Intenta de nuevo.')\n    } catch (err) {\n      console.warn('[Auth] Device auth error:', err)\n      setAuthError(err.message)\n      setAuthing(false)\n      setAuthCode('')\n    }\n  }, [getClientId])\n\n  const handleLogout = useCallback(() => {\n    clearAuth()\n    setAuth({ token: null, username: null })\n  }, [])\n\n  // ─── WebSocket IRC ─────────────────────────────────────────\n  useEffect(() => {\n    if (!channel) return\n    let cancelled = false\n    let retryDelay = 1000\n    const MAX_RETRY = 30000\n    setConnError('')\n    lineBufferRef.current = ''\n\n    const connect = () => {\n      if (cancelled) return\n      const ws = new WebSocket('wss://irc-ws.chat.twitch.tv:443')\n      wsRef.current = ws\n      let reconnectTimer = null\n\n      ws.onopen = () => {\n        if (cancelled) { ws.close(); return }\n        retryDelay = 1000 // Reset on success\n        ws.send('CAP REQ :twitch.tv/tags twitch.tv/commands')\n\n        if (auth.token && auth.username) {\n          ws.send(`PASS oauth:${auth.token}`)\n          ws.send(`NICK ${auth.username}`)\n        } else {\n          ws.send('PASS SCHMOOPIIE')\n          ws.send('NICK justinfan12345')\n        }\n\n        ws.send(`JOIN #${channel}`)\n        setConnected(true)\n        setConnError('')\n      }\n\n      ws.onmessage = (event) => {\n        if (cancelled) return\n        lineBufferRef.current += event.data\n        const lines = lineBufferRef.current.split('\\r\\n')\n        lineBufferRef.current = lines.pop() || ''\n\n        for (const line of lines) {\n          if (!line) continue\n          if (line.startsWith('PING')) {\n            ws.send('PONG :tmi.twitch.tv')\n            continue\n          }\n\n          const tagEnd = line.indexOf(' ')\n          if (tagEnd === -1) continue\n          const tags = line.slice(0, tagEnd)\n          const rest = line.slice(tagEnd + 1)\n          const parts = rest.split(' ')\n          const privmsgIdx = parts.indexOf('PRIVMSG')\n          if (privmsgIdx === -1) continue\n\n          const userRaw = parts[0]?.split('!')[0]?.replace(':', '') || 'unknown'\n          const messageParts = parts.slice(privmsgIdx + 2)\n          const message = messageParts.join(' ').replace(/^:/, '')\n\n          const parsed = parseMessageTags(tags)\n          const badgeList = parsed.badges\n            ? parsed.badges.split(',').map(b => {\n                const [set, version] = b.split('/')\n                return { set, version }\n              })\n            : []\n\n          setMessages(prev => {\n            const updated = [...prev, {\n              id: crypto.randomUUID(),\n              user: userRaw,\n              color: parsed['color'] || null,\n              message,\n              emotes: parsed['emotes'] || '',\n              badges: badgeList,\n            }]\n            return updated.length > 500 ? updated.slice(-500) : updated\n          })\n\n          if (!isAtBottomRef.current) {\n            setNewMsgCount(c => c + 1)\n          }\n        }\n      }\n\n      ws.onclose = () => {\n        if (cancelled) return\n        setConnected(false)\n        setConnError(`Reconectando en ${retryDelay/1000}s...`)\n        reconnectTimer = setTimeout(() => {\n          retryDelay = Math.min(retryDelay * 2, MAX_RETRY)\n          connect()\n        }, retryDelay)\n      }\n\n      ws.onerror = () => {\n        if (cancelled) return\n        setConnError('Error de conexión al chat')\n      }\n    }\n\n    connect()\n\n    return () => {\n      cancelled = true\n      if (wsRef.current) {\n        wsRef.current.close()\n        wsRef.current = null\n      }\n    }\n  }, [channel, auth])\n\n  // Auto-scroll\n  useEffect(() => {\n    if (isAtBottomRef.current) {\n      bottomRef.current?.scrollIntoView({ behavior: 'smooth' })\n    }\n  }, [messages])\n\n  // Auto-scroll\n  useEffect(() => {\n    if (isAtBottomRef.current) {\n      bottomRef.current?.scrollIntoView({ behavior: 'smooth' })\n    }\n  }, [messages])\n\n  // ─── Comandos de chat ──────────────────────────────────\n  function parseChatCommand(text) {\n    // /me action → CTCP ACTION\n    const meMatch = text.match(/^\\/me\\s+(.+)/i)\n    if (meMatch) {\n      return `PRIVMSG #${channel} :\\u0001ACTION ${meMatch[1]}\\u0001`\n    }\n\n    // Comandos que se envían como texto literal (Twitch los interpreta)\n    const cmdMatch = text.match(/^\\/(\\w+)\\b\\s*(.*)/)\n    if (cmdMatch) {\n      const cmd = cmdMatch[1].toLowerCase()\n      const args = cmdMatch[2]\n      // Lista de comandos soportados\n      const supported = ['ban', 'unban', 'timeout', 'untimeout', 'mods', 'vips',\n        'slow', 'slowoff', 'followers', 'followersoff', 'subscribers', 'subscribersoff',\n        'emoteonly', 'emoteonlyoff', 'clear', 'host', 'unhost', 'raid', 'unraid',\n        'color', 'commercial', 'delete', 'announce', 'shoutout']\n      if (supported.includes(cmd)) {\n        return `PRIVMSG #${channel} :/${cmd} ${args}`.trimEnd()\n      }\n      // Comando no soportado: mostrar error\n      setConnError(`Comando /${cmd} no reconocido`)\n      return null\n    }\n\n    // Mensaje normal\n    return `PRIVMSG #${channel} :${text}`\n  }\n\n  // Send message\n  const sendMessage = (e) => {\n    e.preventDefault()\n    const text = inputText.trim()\n    if (!text || !wsRef.current || wsRef.current.readyState !== WebSocket.OPEN) return\n    if (!auth.token) {\n      setConnError('Debes iniciar sesión para enviar mensajes')\n      return\n    }\n\n    const cmd = parseChatCommand(text)\n    if (cmd) {\n      wsRef.current.send(cmd)\n      setInputText('')\n    }\n  }\n\n  return (\n    <div className=\"h-full flex flex-col bg-chat\">\n      {/* ─── Cabecera ─── */}\n      <div className=\"shrink-0 px-3 py-2 bg-bg-secondary/50 backdrop-blur-sm border-b border-bg-tertiary/50 flex items-center gap-2\">\n        <span className={`w-1.5 h-1.5 rounded-full ${connected ? 'bg-green-500' : 'bg-red-500'}`} />\n        <span className=\"text-xs text-text-secondary font-medium truncate\">{channel}</span>\n\n        <div className=\"flex-1\" />\n\n        {/* Login / User info */}\n        {auth.token ? (\n          <div className=\"flex items-center gap-1.5\">\n            <span className=\"text-[10px] text-twitch/80 font-medium truncate max-w-[80px]\">\n              {auth.username || 'Conectado'}\n            </span>\n            <button\n              onClick={handleLogout}\n              className=\"text-[10px] text-text-muted/60 hover:text-red-400 cursor-pointer transition-colors\"\n              title=\"Cerrar sesión\"\n            >\n              Salir\n            </button>\n          </div>\n        ) : (\n          <div className=\"relative\">\n            <button\n              onClick={() => setShowLoginOptions(p => !p)}\n              disabled={authing}\n              className=\"flex items-center gap-1 text-[10px] px-2 py-0.5 rounded-md bg-twitch/20 hover:bg-twitch/40 text-twitch cursor-pointer disabled:opacity-40 transition-colors\"\n            >\n              {authing ? (\n                <>\n                  <span className=\"w-2.5 h-2.5 border border-twitch border-t-transparent rounded-full animate-spin\" />\n                  Conectando…\n                </>\n              ) : (\n                'Iniciar sesión'\n              )}\n            </button>\n\n            {/* Panel de opciones de login */}\n            {showLoginOptions && !authing && (\n              <div className=\"absolute right-0 top-full mt-1 w-80 bg-bg-secondary border border-bg-tertiary/60 rounded-xl shadow-2xl z-50 p-3 animate-fade-in\" onClick={e => e.stopPropagation()}>\n                <p className=\"text-[10px] font-semibold text-text-primary mb-2\">Iniciar sesión en Twitch</p>\n\n                {/* Opción 1: Token manual (recomendado) */}\n                <div className=\"mb-2\">\n                  <p className=\"text-[10px] text-text-muted mb-1.5 leading-relaxed\">\n                    1. <button onClick={handleOpenTokenSite} className=\"text-twitch hover:underline cursor-pointer\">\n                      {copiedUrl ? '✓ URL copiada' : 'Copiar URL del generador'}\n                    </button>\n                  </p>\n                  <p className=\"text-[9px] text-text-muted/60 mb-1 leading-relaxed\">\n                    Pega la URL en tu navegador, ingresa tu Client ID y Secret, y obtén tu token:\n                  </p>\n                  <p className=\"text-[10px] text-text-muted mb-1.5\">\n                    2. Pega el token aquí y haz clic en <strong className=\"text-text-secondary\">Conectar</strong>:\n                  </p>\n                  <div className=\"flex gap-1\">\n                    <input\n                      type=\"text\"\n                      value={manualToken}\n                      onChange={e => setManualToken(e.target.value)}\n                      placeholder=\"Pega tu token aquí...\"\n                      className=\"flex-1 px-2 py-1.5 rounded-lg bg-bg-tertiary text-text-primary placeholder-text-muted/40 text-[10px] border border-transparent focus:border-twitch focus:outline-none transition-colors\"\n                      onKeyDown={e => { if (e.key === 'Enter') handleManualTokenSubmit() }}\n                    />\n                    <button\n                      onClick={handleManualTokenSubmit}\n                      disabled={authing || !manualToken.trim()}\n                      className=\"px-2.5 py-1 rounded-lg bg-twitch text-white text-[10px] font-medium cursor-pointer disabled:opacity-30 hover:bg-twitch-dark transition-colors shrink-0\"\n                    >\n                      {authing ? '...' : 'Conectar'}\n                    </button>\n                  </div>\n                </div>\n\n                {/* Separador */}\n                <div className=\"flex items-center gap-2 my-2\">\n                  <div className=\"flex-1 h-px bg-bg-tertiary/50\" />\n                  <span className=\"text-[9px] text-text-muted/40\">o</span>\n                  <div className=\"flex-1 h-px bg-bg-tertiary/50\" />\n                </div>\n\n                {/* Opción 2: Device Code */}\n                <button\n                  onClick={handleDeviceCodeLogin}\n                  className=\"w-full text-[10px] py-1.5 rounded-lg bg-bg-tertiary hover:bg-bg-tertiary/80 text-text-secondary cursor-pointer transition-colors\"\n                >\n                  Iniciar sesión con código de dispositivo\n                </button>\n\n                {/* Opción 3: Avanzado — Client-ID propio */}\n                <div className=\"mt-2\">\n                  <button\n                    onClick={() => setShowAdvanced(p => !p)}\n                    className=\"text-[9px] text-text-muted/50 hover:text-text-muted cursor-pointer transition-colors\"\n                  >\n                    {showAdvanced ? '− Ocultar opciones avanzadas' : '+ Opciones avanzadas'}\n                  </button>\n\n                  {showAdvanced && (\n                    <div className=\"mt-1.5 p-2 rounded-lg bg-bg-tertiary/50 border border-bg-tertiary/60\">\n                      <p className=\"text-[9px] text-text-muted mb-1 leading-relaxed\">\n                        Si creaste tu propia app en{' '}\n                        <a href=\"https://dev.twitch.tv/console/apps\" target=\"_blank\" rel=\"noopener noreferrer\" className=\"text-twitch hover:underline\">dev.twitch.tv</a>\n                        {' '}(con redirect URI <code className=\"text-[8px] bg-bg-secondary px-1 rounded\">/functions/v1/twitch-auth</code>),\n                        ingresa tu <strong className=\"text-text-secondary\">Client-ID</strong>:\n                      </p>\n                      <div className=\"flex gap-1\">\n                        <input\n                          type=\"text\"\n                          value={customClientId}\n                          onChange={e => {\n                            setCustomClientId(e.target.value)\n                            saveCustomClientId(e.target.value)\n                          }}\n                          placeholder={DEFAULT_CLIENT_ID}\n                          className=\"flex-1 px-2 py-1 rounded-lg bg-bg-secondary text-text-primary placeholder-text-muted/30 text-[9px] border border-bg-tertiary focus:border-twitch focus:outline-none transition-colors\"\n                        />\n                      </div>\n                      <p className=\"text-[8px] text-text-muted/40 mt-1\">Se guarda automáticamente. Vacío = usa el Client-ID por defecto.</p>\n                    </div>\n                  )}\n                </div>\n\n                <p className=\"text-[9px] text-text-muted/40 mt-2 text-center\">\n                  Token guardado localmente en tu PC\n                </p>\n              </div>\n            )}\n          </div>\n        )}\n\n        <span className=\"text-[10px] text-text-muted/40 ml-1\">{messages.length}</span>\n      </div>\n\n      {/* ─── Autenticación (Device Code) ─── */}\n      {authing && authCode && (\n        <div className=\"shrink-0 px-3 py-4 bg-bg-secondary/80 border-b border-twitch/20 text-center animate-fade-in\">\n          <p className=\"text-xs font-semibold text-twitch mb-2\">Autorizar BlinkStream</p>\n          <p className=\"text-[10px] text-text-muted mb-1\">\n            1. Abre <strong className=\"text-text-secondary\">twitch.tv/activate</strong> en tu navegador\n          </p>\n          <p className=\"text-[10px] text-text-muted/60 mb-2\">o abre: <code className=\"text-[9px] bg-bg-tertiary px-1 rounded select-all\">https://www.twitch.tv/activate</code></p>\n          <p className=\"text-[10px] text-text-muted mb-2\">\n            2. Ingresa este código:\n          </p>\n          <div className=\"inline-block px-4 py-2 rounded-lg bg-bg-tertiary border border-twitch/40\">\n            <span className=\"text-lg font-bold tracking-[0.25em] text-twitch select-all\">{authCode}</span>\n          </div>\n          <p className=\"text-[10px] text-text-muted/60 mt-3\">3. Autoriza y espera aquí...</p>\n        </div>\n      )}\n\n      {/* ─── Error de autenticación ─── */}\n      {authError && (\n        <div className=\"shrink-0 px-3 py-2 bg-red-900/20 border-b border-red-500/20 text-center\">\n          <p className=\"text-[10px] text-red-400\">{authError}</p>\n        </div>\n      )}\n\n      {/* ─── Mensajes ─── */}\n      <div ref={containerRef} className=\"flex-1 overflow-y-auto px-1 py-0.5\" onScroll={handleScroll}>\n        {connError && !connected && (\n          <p className=\"text-orange-400/80 text-xs text-center mt-4\">{connError}</p>\n        )}\n        {messages.length === 0 && !connError && !authing && (\n          <p className=\"text-text-muted/50 text-xs text-center mt-6\">\n            {connected ? 'Esperando mensajes...' : 'Conectando al chat...'}\n          </p>\n        )}\n\n        <div className=\"space-y-0.5\">\n          {messages.map(msg => (\n            <div\n              key={msg.id}\n              className=\"flex gap-1 text-sm leading-relaxed hover:bg-bg-tertiary/20 px-1.5 py-0.5 rounded transition-colors\"\n            >\n              {msg.badges.length > 0 && (\n                <span className=\"flex gap-0.5 shrink-0 items-center pt-0.5\">\n                  {msg.badges.map((b, i) => {\n                    const url = badgeUrls[`${msg.id}-${b.set}`]\n                    return url ? <img key={i} src={url} alt={b.set} className=\"w-3.5 h-3.5\" loading=\"lazy\" /> : null\n                  })}\n                </span>\n              )}\n              <span\n                className=\"font-semibold shrink-0 hover:underline cursor-pointer text-[13px]\"\n                style={{ color: msg.color || '#adadb8' }}\n              >\n                {msg.user}\n              </span>\n              <span className=\"text-text-primary break-words min-w-0 text-[13px]\">\n                {renderMessage(msg.message, msg.emotes)}\n              </span>\n            </div>\n          ))}\n        </div>\n\n        <div ref={bottomRef} />\n      </div>\n\n      {/* ─── Botón \"nuevos mensajes\" ─── */}\n      {newMsgCount > 0 && (\n        <button\n          onClick={scrollToBottom}\n          className=\"shrink-0 w-full bg-twitch/90 hover:bg-twitch text-white text-[11px] font-medium py-1 cursor-pointer transition-colors\"\n        >\n          {newMsgCount} nuevo{newMsgCount !== 1 ? 's' : ''} ↓\n        </button>\n      )}\n\n      {/* ─── Input ─── */}\n      <div className=\"shrink-0\">\n        {inputText.startsWith('/') && auth.token && (\n          <div className=\"px-2 py-1 bg-bg-tertiary/40 border-t border-bg-tertiary/30 text-[9px] text-text-muted/60 flex flex-wrap gap-x-2 gap-y-0.5 animate-fade-in\">\n            <span><strong className=\"text-text-secondary\">/me</strong> texto</span>\n            <span><strong className=\"text-text-secondary\">/ban</strong> user</span>\n            <span><strong className=\"text-text-secondary\">/timeout</strong> user s</span>\n            <span><strong className=\"text-text-secondary\">/slow</strong> seg</span>\n            <span><strong className=\"text-text-secondary\">/clear</strong></span>\n            <span><strong className=\"text-text-secondary\">/mods</strong></span>\n            <span><strong className=\"text-text-secondary\">/raid</strong> canal</span>\n          </div>\n        )}\n        <form onSubmit={sendMessage} className=\"flex gap-1.5 p-2 bg-bg-secondary/50 border-t border-bg-tertiary/50\">\n          <input\n            type=\"text\"\n            value={inputText}\n            onChange={(e) => setInputText(e.target.value)}\n            placeholder={connected\n              ? (auth.token ? 'Escribe un mensaje...' : 'Inicia sesión para chatear')\n              : 'Sin conexión'\n            }\n            disabled={!connected || !auth.token}\n            maxLength={500}\n            className=\"flex-1 px-2.5 py-1.5 rounded-lg bg-bg-tertiary text-text-primary placeholder-text-muted/40 text-sm border border-transparent focus:border-twitch focus:ring-1 focus:ring-twitch/30 focus:outline-none transition-all disabled:opacity-40\"\n          />\n          <button\n            type=\"submit\"\n            disabled={!connected || !inputText.trim() || !auth.token}\n            className=\"px-3 py-1.5 rounded-lg bg-twitch text-white text-sm font-medium cursor-pointer disabled:opacity-30 disabled:cursor-not-allowed hover:bg-twitch-dark transition-colors\"\n          >\n            Enviar\n          </button>\n        </form>\n      </div>\n    </div>\n  )\n}\n","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\alber\\Desktop\\IA Project\\BlinkStream\\blinkstream\\src\\components\\Favorites.jsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\alber\\Desktop\\IA Project\\BlinkStream\\blinkstream\\src\\components\\HomeScreen.jsx","messages":[{"ruleId":"react-hooks/set-state-in-effect","severity":2,"message":"Error: Calling setState synchronously within an effect can trigger cascading renders\n\nEffects are intended to synchronize state between React and external systems such as manually updating the DOM, state management libraries, or other platform APIs. In general, the body of an effect should do one or both of the following:\n* Update external systems with the latest state from React.\n* Subscribe for updates from some external system, calling setState in a callback function when external state changes.\n\nCalling setState synchronously within an effect body causes cascading renders that can hurt performance, and is not recommended. (https://react.dev/learn/you-might-not-need-an-effect).\n\n  283 |\n  284 |   useEffect(() => {\n> 285 |     fetchLiveStatus()\n      |     ^^^^^^^^^^^^^^^ Avoid calling setState() directly within an effect\n  286 |     const interval = setInterval(fetchLiveStatus, 60000)\n  287 |     return () => clearInterval(interval)\n  288 |   }, [fetchLiveStatus])","line":285,"column":5,"endLine":285,"endColumn":20},{"ruleId":"react-hooks/set-state-in-effect","severity":2,"message":"Error: Calling setState synchronously within an effect can trigger cascading renders\n\nEffects are intended to synchronize state between React and external systems such as manually updating the DOM, state management libraries, or other platform APIs. In general, the body of an effect should do one or both of the following:\n* Update external systems with the latest state from React.\n* Subscribe for updates from some external system, calling setState in a callback function when external state changes.\n\nCalling setState synchronously within an effect body causes cascading renders that can hurt performance, and is not recommended. (https://react.dev/learn/you-might-not-need-an-effect).\n\n  303 |   }, [])\n  304 |\n> 305 |   useEffect(() => { fetchCategories() }, [fetchCategories])\n      |                     ^^^^^^^^^^^^^^^ Avoid calling setState() directly within an effect\n  306 |\n  307 |   // ─── Fetch top streams via GQL ───\n  308 |   const fetchTopStreams = useCallback(async () => {","line":305,"column":21,"endLine":305,"endColumn":36},{"ruleId":"react-hooks/set-state-in-effect","severity":2,"message":"Error: Calling setState synchronously within an effect can trigger cascading renders\n\nEffects are intended to synchronize state between React and external systems such as manually updating the DOM, state management libraries, or other platform APIs. In general, the body of an effect should do one or both of the following:\n* Update external systems with the latest state from React.\n* Subscribe for updates from some external system, calling setState in a callback function when external state changes.\n\nCalling setState synchronously within an effect body causes cascading renders that can hurt performance, and is not recommended. (https://react.dev/learn/you-might-not-need-an-effect).\n\n  332 |   }, [])\n  333 |\n> 334 |   useEffect(() => { fetchTopStreams() }, [fetchTopStreams])\n      |                     ^^^^^^^^^^^^^^^ Avoid calling setState() directly within an effect\n  335 |\n  336 |   // ─── Search handler ───\n  337 |   const handleSearch = (e) => {","line":334,"column":21,"endLine":334,"endColumn":36}],"suppressedMessages":[],"errorCount":3,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { useState, useEffect, useCallback, useRef } from 'react'\nimport { MinimalLogo } from './MinimalLogo'\n\nconst PUBLIC_CLIENT_ID = 'kimne78kx3ncx6brgo4mv6wki5h1ko'\n\nfunction formatViewers(n) {\n  if (n == null) return null\n  return n >= 1000 ? `${(n / 1000).toFixed(1)}k` : String(n)\n}\n\n// ─── Iconos flechas ───\nfunction ArrowLeft() {\n  return (\n    <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2.5\" strokeLinecap=\"round\" strokeLinejoin=\"round\">\n      <path d=\"M15 18l-6-6 6-6\" />\n    </svg>\n  )\n}\nfunction ArrowRight() {\n  return (\n    <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2.5\" strokeLinecap=\"round\" strokeLinejoin=\"round\">\n      <path d=\"M9 18l6-6-6-6\" />\n    </svg>\n  )\n}\n\n// ─── Scroll row con flechas de navegación ───\nfunction ScrollableRow({ children, cardWidth = 260 }) {\n  const scrollRef = useRef(null)\n  const [atStart, setAtStart] = useState(true)\n  const [atEnd, setAtEnd] = useState(true)\n\n  const checkScroll = useCallback(() => {\n    const el = scrollRef.current\n    if (!el) return\n    setAtStart(el.scrollLeft <= 2)\n    setAtEnd(el.scrollLeft >= el.scrollWidth - el.clientWidth - 2)\n  }, [])\n\n  // Re-check when children change (data loaded)\n  useEffect(() => {\n    // small delay to let DOM paint\n    const t = setTimeout(checkScroll, 100)\n    return () => clearTimeout(t)\n  }, [children, checkScroll])\n\n  const scrollBy = (dir) => {\n    const el = scrollRef.current\n    if (!el) return\n    // Scroll 2 cards + gap\n    const step = (cardWidth + 12) * 2\n    el.scrollBy({ left: dir * step, behavior: 'smooth' })\n  }\n\n  return (\n    <div className=\"relative group/scroll\">\n      {/* Botón izquierdo */}\n      {!atStart && (\n        <button\n          onClick={() => scrollBy(-1)}\n          className=\"absolute left-0 top-0 bottom-2 z-10 w-10 flex items-center justify-start cursor-pointer\n                     bg-gradient-to-r from-bg-primary/95 via-bg-primary/80 to-transparent\n                     text-text-muted hover:text-text-primary transition-all opacity-0 group-hover/scroll:opacity-100\"\n          aria-label=\"Anterior\"\n        >\n          <ArrowLeft />\n        </button>\n      )}\n      {/* Botón derecho */}\n      {!atEnd && (\n        <button\n          onClick={() => scrollBy(1)}\n          className=\"absolute right-0 top-0 bottom-2 z-10 w-10 flex items-center justify-end cursor-pointer\n                     bg-gradient-to-l from-bg-primary/95 via-bg-primary/80 to-transparent\n                     text-text-muted hover:text-text-primary transition-all opacity-0 group-hover/scroll:opacity-100\"\n          aria-label=\"Siguiente\"\n        >\n          <ArrowRight />\n        </button>\n      )}\n      {/* Contenedor scrolleable */}\n      <div\n        ref={scrollRef}\n        onScroll={checkScroll}\n        className=\"flex gap-3 overflow-x-auto pb-2 scrollbar-thin -mx-4 sm:-mx-6 px-4 sm:px-6\"\n      >\n        {children}\n      </div>\n    </div>\n  )\n}\n\n// ─── Stream Card ───\nfunction StreamCard({ stream, onSelect }) {\n  return (\n    <button\n      onClick={() => onSelect(stream.user_login)}\n      className=\"shrink-0 w-[220px] sm:w-[260px] text-left group cursor-pointer\"\n    >\n      <div className=\"relative aspect-video rounded-lg overflow-hidden bg-bg-tertiary\">\n        <img\n          src={stream.thumbnail_url?.replace('{width}', '440').replace('{height}', '248') || ''}\n          alt=\"\"\n          className=\"w-full h-full object-cover transition-transform duration-300 group-hover:scale-105\"\n          loading=\"lazy\"\n        />\n        <div className=\"absolute top-2 left-2 flex items-center gap-1 bg-red-600 px-1.5 py-0.5 rounded text-[11px] font-bold text-white leading-none\">\n          LIVE\n        </div>\n        {stream.viewer_count != null && (\n          <div className=\"absolute bottom-2 left-2 bg-black/80 backdrop-blur-sm px-1.5 py-0.5 rounded text-[11px] text-white/90 flex items-center gap-1 leading-none\">\n            <svg width=\"10\" height=\"10\" viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5z\"/></svg>\n            {formatViewers(stream.viewer_count)}\n          </div>\n        )}\n        {stream.game_name && (\n          <div className=\"absolute bottom-2 right-2 bg-black/80 backdrop-blur-sm px-1.5 py-0.5 rounded text-[11px] text-white/80 leading-none truncate max-w-[50%]\">\n            {stream.game_name}\n          </div>\n        )}\n        <div className=\"absolute inset-0 bg-black/0 group-hover:bg-black/20 transition-colors duration-200 flex items-center justify-center\">\n          <div className=\"w-10 h-10 rounded-full bg-twitch/90 opacity-0 group-hover:opacity-100 transition-opacity duration-200 flex items-center justify-center shadow-lg\">\n            <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"white\"><path d=\"M8 5v14l11-7z\"/></svg>\n          </div>\n        </div>\n      </div>\n      <div className=\"flex gap-2 mt-2 px-0.5\">\n        <div className=\"w-8 h-8 rounded-full bg-twitch/20 flex items-center justify-center text-[11px] font-bold text-twitch shrink-0 overflow-hidden\">\n          {stream.user_login[0]?.toUpperCase()}\n        </div>\n        <div className=\"min-w-0 flex-1\">\n          <p className=\"text-sm font-semibold text-text-primary truncate leading-tight\">{stream.user_login}</p>\n          <p className=\"text-xs text-text-muted/70 truncate leading-tight mt-0.5\">{stream.title}</p>\n          <p className=\"text-[11px] text-text-muted/50 leading-tight mt-0.5\">{stream.game_name}</p>\n        </div>\n      </div>\n    </button>\n  )\n}\n\n// ─── Category Card ───\nfunction CategoryCard({ cat, onSelect }) {\n  return (\n    <button\n      onClick={() => onSelect(cat.name)}\n      className=\"shrink-0 w-[120px] sm:w-[140px] text-left group cursor-pointer\"\n    >\n      <div className=\"aspect-[3/4] rounded-lg overflow-hidden bg-bg-tertiary relative\">\n        {cat.box_art_url ? (\n          <img\n            src={cat.box_art_url.replace('{width}', '144').replace('{height}', '192')}\n            alt=\"\"\n            className=\"w-full h-full object-cover transition-transform duration-300 group-hover:scale-105\"\n            loading=\"lazy\"\n          />\n        ) : (\n          <div className=\"w-full h-full flex items-center justify-center bg-gradient-to-br from-twitch/20 to-bg-tertiary\">\n            <span className=\"text-4xl font-bold text-twitch/20\">{cat.name[0]}</span>\n          </div>\n        )}\n        <div className=\"absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/90 via-black/30 to-transparent p-2 pt-8\">\n          <p className=\"text-xs font-semibold text-white truncate drop-shadow-lg\">{cat.name}</p>\n        </div>\n      </div>\n    </button>\n  )\n}\n\n// ─── Channel Card (favoritos) ───\nfunction ChannelCard({ name, status, onSelect }) {\n  const isLive = status?.live\n  return (\n    <button\n      onClick={() => onSelect(name)}\n      className=\"shrink-0 w-[220px] sm:w-[260px] text-left group cursor-pointer\"\n    >\n      <div className=\"relative aspect-video rounded-lg overflow-hidden bg-bg-tertiary\">\n        {status?.thumbnail ? (\n          <img\n            src={status.thumbnail}\n            alt=\"\"\n            className=\"w-full h-full object-cover transition-transform duration-300 group-hover:scale-105\"\n            loading=\"lazy\"\n          />\n        ) : (\n          <div className=\"w-full h-full flex items-center justify-center\">\n            <span className=\"text-3xl font-bold text-text-muted/20\">{name[0]?.toUpperCase()}</span>\n          </div>\n        )}\n        {isLive && (\n          <>\n            <div className=\"absolute top-2 left-2 flex items-center gap-1 bg-red-600 px-1.5 py-0.5 rounded text-[11px] font-bold text-white leading-none\">LIVE</div>\n            {status.viewers != null && (\n              <div className=\"absolute bottom-2 left-2 bg-black/80 backdrop-blur-sm px-1.5 py-0.5 rounded text-[11px] text-white/90 flex items-center gap-1 leading-none\">\n                <svg width=\"10\" height=\"10\" viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5z\"/></svg>\n                {formatViewers(status.viewers)}\n              </div>\n            )}\n            {status.game && (\n              <div className=\"absolute bottom-2 right-2 bg-black/80 backdrop-blur-sm px-1.5 py-0.5 rounded text-[11px] text-white/80 leading-none truncate max-w-[50%]\">{status.game}</div>\n            )}\n          </>\n        )}\n        {isLive && (\n          <div className=\"absolute inset-0 bg-black/0 group-hover:bg-black/20 transition-colors duration-200 flex items-center justify-center\">\n            <div className=\"w-10 h-10 rounded-full bg-twitch/90 opacity-0 group-hover:opacity-100 transition-opacity duration-200 flex items-center justify-center shadow-lg\">\n              <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"white\"><path d=\"M8 5v14l11-7z\"/></svg>\n            </div>\n          </div>\n        )}\n      </div>\n      <div className=\"flex gap-2 mt-2 px-0.5\">\n        <div className=\"w-8 h-8 rounded-full bg-twitch/20 flex items-center justify-center text-[11px] font-bold text-twitch shrink-0 overflow-hidden\">\n          {name[0]?.toUpperCase()}\n        </div>\n        <div className=\"min-w-0 flex-1\">\n          <p className=\"text-sm font-semibold text-text-primary truncate leading-tight flex items-center gap-1.5\">\n            {name}\n            {!isLive && status !== undefined && (\n              <span className=\"text-[10px] font-normal text-text-muted/40\">— Offline</span>\n            )}\n          </p>\n          {isLive && status?.title && (\n            <p className=\"text-xs text-text-muted/70 truncate leading-tight mt-0.5\">{status.title}</p>\n          )}\n          {isLive && <p className=\"text-[11px] text-text-muted/50 leading-tight mt-0.5\">{status.game}</p>}\n        </div>\n      </div>\n    </button>\n  )\n}\n\n// ─── Section header ───\nfunction SectionHeader({ title }) {\n  return (\n    <div className=\"flex items-center justify-between mb-3 px-0.5\">\n      <h2 className=\"text-base font-bold text-text-primary\">{title}</h2>\n    </div>\n  )\n}\n\n// ─── GQL helper ───\nasync function gql(query) {\n  const res = await fetch('https://gql.twitch.tv/gql', {\n    method: 'POST',\n    headers: { 'Client-ID': PUBLIC_CLIENT_ID, 'Content-Type': 'application/json' },\n    body: JSON.stringify({ query }),\n  })\n  if (!res.ok) throw new Error(`GQL error: ${res.status}`)\n  return res.json()\n}\n\nexport default function HomeScreen({ onSelect, favorites, recentChannels = [] }) {\n  const [searchValue, setSearchValue] = useState('')\n  const [liveStatus, setLiveStatus] = useState({})\n  const [categories, setCategories] = useState([])\n  const [topStreams, setTopStreams] = useState([])\n\n  // ─── Fetch live status ───\n  const fetchLiveStatus = useCallback(async () => {\n    const allNames = [...new Set([...favorites, ...recentChannels])]\n    if (!allNames.length) return\n    try {\n      const res = await fetch(\n        `https://api.twitch.tv/helix/streams?${allNames.map(n => `user_login=${encodeURIComponent(n)}`).join('&')}`,\n        { headers: { 'Client-ID': PUBLIC_CLIENT_ID } }\n      )\n      if (res.ok) {\n        const data = await res.json()\n        const statusMap = {}\n        data.data.forEach(s => {\n          statusMap[s.user_login.toLowerCase()] = {\n            live: true, title: s.title, game: s.game_name,\n            viewers: s.viewer_count,\n            thumbnail: s.thumbnail_url?.replace('{width}', '440').replace('{height}', '248'),\n          }\n        })\n        allNames.forEach(n => { if (!statusMap[n.toLowerCase()]) statusMap[n.toLowerCase()] = { live: false } })\n        setLiveStatus(statusMap)\n      }\n    } catch { /* ignore */ }\n  }, [favorites, recentChannels])\n\n  useEffect(() => {\n    fetchLiveStatus()\n    const interval = setInterval(fetchLiveStatus, 60000)\n    return () => clearInterval(interval)\n  }, [fetchLiveStatus])\n\n  // ─── Fetch top categories via GQL ───\n  const fetchCategories = useCallback(async () => {\n    try {\n      const json = await gql(`{\n        games(first: 20) {\n          edges {\n            node { id displayName boxArtURL(width: 144, height: 192) }\n          }\n        }\n      }`)\n      const nodes = json?.data?.games?.edges?.map(e => e.node) || []\n      setCategories(nodes.map(n => ({ id: n.id, name: n.displayName, box_art_url: n.boxArtURL })))\n    } catch { /* ignore */ }\n  }, [])\n\n  useEffect(() => { fetchCategories() }, [fetchCategories])\n\n  // ─── Fetch top streams via GQL ───\n  const fetchTopStreams = useCallback(async () => {\n    try {\n      const json = await gql(`{\n        streams(first: 15) {\n          edges {\n            node {\n              id title viewersCount\n              game { displayName }\n              broadcaster { login displayName }\n              previewImageURL\n            }\n          }\n        }\n      }`)\n      const nodes = json?.data?.streams?.edges?.map(e => e.node) || []\n      setTopStreams(nodes.map(n => ({\n        id: n.id, title: n.title,\n        user_login: n.broadcaster.login,\n        user_name: n.broadcaster.displayName,\n        game_name: n.game?.displayName || '',\n        viewer_count: n.viewersCount,\n        thumbnail_url: n.previewImageURL,\n      })))\n    } catch { /* ignore */ }\n  }, [])\n\n  useEffect(() => { fetchTopStreams() }, [fetchTopStreams])\n\n  // ─── Search handler ───\n  const handleSearch = (e) => {\n    e.preventDefault()\n    const val = searchValue.trim()\n    if (val) onSelect(val)\n  }\n\n  return (\n    <div className=\"flex-1 overflow-y-auto animate-fade-in\">\n      <div className=\"py-5\">\n\n        {/* ═══════ LOGO + BUSCADOR ═══════ */}\n        <div className=\"flex flex-col items-center gap-4 mb-7 px-4 select-none\">\n          <MinimalLogo size={56} />\n          <form onSubmit={handleSearch} className=\"w-full max-w-lg group\">\n            <div className=\"relative\">\n              <svg className=\"absolute left-3.5 top-1/2 -translate-y-1/2 text-text-muted transition-colors group-focus-within:text-twitch\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2.5\">\n                <circle cx=\"11\" cy=\"11\" r=\"8\"/><path d=\"m21 21-4.35-4.35\"/>\n              </svg>\n              <input\n                type=\"text\"\n                value={searchValue}\n                onChange={(e) => setSearchValue(e.target.value)}\n                placeholder=\"Buscar canal o categoría…\"\n                className=\"w-full pl-10 pr-4 py-2.5 rounded-xl bg-bg-tertiary text-text-primary placeholder-text-muted/50 border border-bg-tertiary focus:border-twitch focus:ring-2 focus:ring-twitch/20 focus:outline-none transition-all text-sm\"\n              />\n            </div>\n          </form>\n        </div>\n\n        {/* ═══════ CANALES RECOMENDADOS ═══════ */}\n        {topStreams.length > 0 && (\n          <div className=\"mb-7\">\n            <div className=\"px-4 sm:px-6\">\n              <SectionHeader title=\"Canales recomendados\" />\n            </div>\n            <ScrollableRow cardWidth={260}>\n              {topStreams.slice(0, 12).map(s => (\n                <StreamCard key={s.id} stream={s} onSelect={onSelect} />\n              ))}\n            </ScrollableRow>\n          </div>\n        )}\n\n        {/* ═══════ CATEGORÍAS POPULARES ═══════ */}\n        {categories.length > 0 && (\n          <div className=\"mb-7\">\n            <div className=\"px-4 sm:px-6\">\n              <SectionHeader title=\"Categorías populares\" />\n            </div>\n            <ScrollableRow cardWidth={140}>\n              {categories.map(cat => (\n                <CategoryCard key={cat.id} cat={cat} onSelect={onSelect} />\n              ))}\n            </ScrollableRow>\n          </div>\n        )}\n\n        {/* ═══════ TUS CANALES ═══════ */}\n        {favorites.length > 0 && (\n          <div className=\"mb-7\">\n            <div className=\"px-4 sm:px-6\">\n              <SectionHeader\n                title={\n                  <span className=\"flex items-center gap-2\">\n                    Tus canales\n                    <span className=\"text-xs font-normal text-text-muted/50\">— Siguiendo</span>\n                  </span>\n                }\n              />\n            </div>\n            <ScrollableRow cardWidth={260}>\n              {favorites.map(name => (\n                <ChannelCard key={name} name={name} status={liveStatus[name.toLowerCase()]} onSelect={onSelect} />\n              ))}\n            </ScrollableRow>\n          </div>\n        )}\n\n        {/* ═══════ RECIENTES ═══════ */}\n        {recentChannels.length > 0 && (\n          <div className=\"mb-7\">\n            <div className=\"px-4 sm:px-6 mb-3\">\n              <h2 className=\"text-base font-bold text-text-primary\">Recientes</h2>\n            </div>\n            <div className=\"flex flex-wrap gap-2 px-4 sm:px-6\">\n              {recentChannels.map(name => {\n                const status = liveStatus[name.toLowerCase()]\n                const isLive = status?.live\n                return (\n                  <button\n                    key={name}\n                    onClick={() => onSelect(name)}\n                    className={`inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-sm cursor-pointer transition-all font-medium border ${\n                      isLive\n                        ? 'bg-red-500/10 hover:bg-red-500/20 text-red-400 border-red-500/20'\n                        : 'bg-bg-tertiary/60 hover:bg-bg-tertiary text-text-secondary hover:text-text-primary border-transparent'\n                    }`}\n                  >\n                    <span className={`w-2 h-2 rounded-full ${isLive ? 'bg-red-500 animate-pulse-dot' : 'bg-text-muted/30'}`} />\n                    {name}\n                  </button>\n                )\n              })}\n            </div>\n          </div>\n        )}\n\n        {/* ═══════ SUGERENCIAS ═══════ */}\n        <div className=\"mb-7\">\n          <div className=\"px-4 sm:px-6 mb-3\">\n            <h2 className=\"text-base font-bold text-text-primary\">Sugerencias</h2>\n          </div>\n          <div className=\"flex flex-wrap gap-2 px-4 sm:px-6\">\n            {['xQc', 'summit1g', 'lirik', 'shroud', 'pokimane', 'timthetatman', 'asmongold', 'sodapoppin', 'forsen'].map(name => {\n              const status = liveStatus[name.toLowerCase()]\n              const isLive = status?.live\n              return (\n                <button\n                  key={name}\n                  onClick={() => onSelect(name)}\n                  className={`inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md text-xs cursor-pointer transition-all ${\n                    isLive\n                      ? 'bg-red-500/10 text-red-400'\n                      : 'bg-bg-tertiary/30 hover:bg-bg-tertiary text-text-muted hover:text-text-primary'\n                  }`}\n                >\n                  <span className={`w-1.5 h-1.5 rounded-full ${isLive ? 'bg-red-500 animate-pulse-dot' : 'bg-text-muted/30'}`} />\n                  {name}\n                </button>\n              )\n            })}\n          </div>\n        </div>\n\n        {/* ═══════ ATAJOS ═══════ */}\n        <div className=\"px-4 sm:px-6 mt-8 mb-4 text-[11px] text-text-muted/40 flex flex-wrap gap-x-4 gap-y-1 justify-center\">\n          <span><kbd className=\"px-1 py-0.5 rounded bg-bg-tertiary text-text-muted/60\">Ctrl+K</kbd> Buscar</span>\n          <span><kbd className=\"px-1 py-0.5 rounded bg-bg-tertiary text-text-muted/60\">Space</kbd> Pausa</span>\n          <span><kbd className=\"px-1 py-0.5 rounded bg-bg-tertiary text-text-muted/60\">F</kbd> Fullscreen</span>\n          <span><kbd className=\"px-1 py-0.5 rounded bg-bg-tertiary text-text-muted/60\">M</kbd> Silencio</span>\n        </div>\n      </div>\n    </div>\n  )\n}\n","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\alber\\Desktop\\IA Project\\BlinkStream\\blinkstream\\src\\components\\LogoIcon.jsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\alber\\Desktop\\IA Project\\BlinkStream\\blinkstream\\src\\components\\MinimalLogo.jsx","messages":[{"ruleId":"no-unused-vars","severity":2,"message":"'fontSize' is assigned a value but never used.","line":9,"column":9,"messageId":"unusedVar","endLine":9,"endColumn":17,"suggestions":[{"messageId":"removeVar","data":{"varName":"fontSize"},"fix":{"range":[277,317],"text":""},"desc":"Remove unused variable 'fontSize'."}]}],"suppressedMessages":[],"errorCount":1,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"/**\n * MinimalLogo — Logo minimalista con iniciales \"BS\" + \"Blink Stream\"\n *\n * Diseño: monograma moderno en caja redondeada con las letras B y S\n * superpuestas estilizadas, y el texto \"Blink Stream\" debajo.\n */\n\nexport function MinimalLogo({ size = 40, className = '' }) {\n  const fontSize = Math.round(size * 0.46)\n  const subSize = Math.round(size * 0.17)\n  const boxSize = Math.round(size * 0.7)\n  const corner = Math.round(size * 0.16)\n\n  return (\n    <svg\n      width={size}\n      height={size}\n      viewBox={`0 0 ${size} ${size}`}\n      fill=\"none\"\n      className={`shrink-0 ${className}`}\n      aria-label=\"BlinkStream\"\n    >\n      <defs>\n        <linearGradient id=\"bs-bg\" x1=\"0\" y1=\"0\" x2={size} y2={size}>\n          <stop offset=\"0%\" stopColor=\"#A970FF\" />\n          <stop offset=\"100%\" stopColor=\"#772CE8\" />\n        </linearGradient>\n      </defs>\n\n      {/* Caja redondeada con gradiente */}\n      <rect\n        x={size * 0.06}\n        y={size * 0.04}\n        width={boxSize}\n        height={boxSize}\n        rx={corner}\n        fill=\"url(#bs-bg)\"\n      />\n\n      {/* Letra \"B\" — trazada como path estilizado */}\n      <path\n        d={`\n          M${size * 0.22} ${size * 0.18}\n          L${size * 0.22} ${size * 0.62}\n          L${size * 0.46} ${size * 0.62}\n          Q${size * 0.58} ${size * 0.62} ${size * 0.58} ${size * 0.53}\n          Q${size * 0.58} ${size * 0.46} ${size * 0.48} ${size * 0.44}\n          Q${size * 0.56} ${size * 0.42} ${size * 0.56} ${size * 0.34}\n          Q${size * 0.56} ${size * 0.18} ${size * 0.40} ${size * 0.18}\n          Z\n        `}\n        fill=\"white\"\n      />\n      {/* Travesaños de la B */}\n      <line\n        x1={size * 0.22} y1={size * 0.34} x2={size * 0.42} y2={size * 0.34}\n        stroke=\"white\" strokeWidth={size * 0.035} strokeLinecap=\"round\"\n      />\n      <line\n        x1={size * 0.22} y1={size * 0.44} x2={size * 0.46} y2={size * 0.44}\n        stroke=\"white\" strokeWidth={size * 0.035} strokeLinecap=\"round\"\n      />\n\n      {/* Letra \"S\" — trazada como path estilizado */}\n      <path\n        d={`\n          M${size * 0.62} ${size * 0.26}\n          Q${size * 0.62} ${size * 0.18} ${size * 0.72} ${size * 0.18}\n          Q${size * 0.82} ${size * 0.18} ${size * 0.82} ${size * 0.28}\n          Q${size * 0.82} ${size * 0.34} ${size * 0.74} ${size * 0.38}\n          L${size * 0.66} ${size * 0.42}\n          Q${size * 0.58} ${size * 0.46} ${size * 0.58} ${size * 0.54}\n          Q${size * 0.58} ${size * 0.64} ${size * 0.68} ${size * 0.64}\n          Q${size * 0.78} ${size * 0.64} ${size * 0.82} ${size * 0.56}\n        `}\n        stroke=\"white\"\n        strokeWidth={size * 0.05}\n        strokeLinecap=\"round\"\n        fill=\"none\"\n      />\n\n      {/* Texto \"Blink Stream\" debajo */}\n      <text\n        x={size * 0.5}\n        y={size * 0.92}\n        textAnchor=\"middle\"\n        fill=\"currentColor\"\n        fontSize={subSize}\n        fontWeight=\"600\"\n        letterSpacing={size * 0.012}\n        fontFamily=\"system-ui, -apple-system, sans-serif\"\n      >\n        Blink Stream\n      </text>\n    </svg>\n  )\n}\n\nexport default Min