lassName=\"w-1.5 h-1.5 rounded-full bg-red-500 animate-pulse-dot\" />\n}\n\nfunction formatViewers(n) {\n  if (n == null) return null\n  return n >= 1000 ? `${(n / 1000).toFixed(1)}k` : String(n)\n}\n\nfunction formatDuration(startedAt) {\n  const diff = Date.now() - new Date(startedAt).getTime()\n  const mins = Math.floor(diff / 60000)\n  if (mins < 1) return 'ahora'\n  return mins >= 60 ? `${Math.floor(mins / 60)}h ${mins % 60}m` : `${mins}m`\n}\n\nexport default function StreamInfo({ channel }) {\n  const [info, setInfo] = useState(null)\n  const [loading, setLoading] = useState(false)\n  const [fetchError, setFetchError] = useState(false)\n\n  useEffect(() => {\n    if (!channel) return\n    let cancelled = false\n    setLoading(true)\n    setFetchError(false)\n\n    const fetchInfo = async () => {\n      // Try Helix API with a public client-id\n      try {\n        const res = await fetch(`https://api.twitch.tv/helix/streams?user_login=${channel}`, {\n          headers: { 'Client-ID': 'kimne78kx3ncx6brgo4mv6wki5h1ko' },\n          signal: AbortSignal.timeout(5000),\n        })\n        if (res.ok) {\n          const data = await res.json()\n          if (!cancelled && data.data?.[0]) {\n            const s = data.data[0]\n            setInfo({\n              title: s.title,\n              game_name: s.game_name,\n              viewer_count: s.viewer_count,\n              started_at: s.started_at,\n            })\n            setFetchError(false)\n            setLoading(false)\n            return\n          }\n        }\n      } catch { /* ignore */ }\n\n      if (!cancelled) {\n        setFetchError(true)\n        setLoading(false)\n      }\n    }\n\n    fetchInfo()\n    return () => { cancelled = true }\n  }, [channel])\n\n  if (loading) {\n    return (\n      <div className=\"shrink-0 px-4 py-1.5 bg-bg-secondary/30 border-b border-bg-tertiary/30 flex items-center gap-2 text-[11px] text-text-muted/60\">\n        <LiveDot />\n        {channel}\n      </div>\n    )\n  }\n\n  if (fetchError && !info) {\n    return (\n      <div className=\"shrink-0 px-4 py-1.5 bg-bg-secondary/30 border-b border-bg-tertiary/30 flex items-center gap-2 text-[11px] text-text-muted/50\">\n        <LiveDot />\n        <span>{channel}</span>\n      </div>\n    )\n  }\n\n  const viewerCount = formatViewers(info?.viewer_count)\n\n  return (\n    <div className=\"shrink-0 px-4 py-1.5 bg-bg-secondary/30 border-b border-bg-tertiary/30 flex items-center gap-3 text-[11px] text-text-secondary\">\n      <LiveDot />\n      <span className=\"font-medium text-text-primary\">{channel}</span>\n\n      {info?.title && (\n        <span className=\"truncate max-w-md text-text-muted/80\" title={info.title}>\n          {info.title}\n        </span>\n      )}\n\n      {info?.game_name && (\n        <span className=\"shrink-0 text-twitch/80 hidden sm:inline\">{info.game_name}</span>\n      )}\n\n      {viewerCount && (\n        <span className=\"shrink-0 text-text-muted/60 hidden sm:inline\">{viewerCount} espectadores</span>\n      )}\n\n      {info?.started_at && (\n        <span className=\"shrink-0 text-text-muted/50 hidden md:inline\">{formatDuration(info.started_at)}</span>\n      )}\n    </div>\n  )\n}\n","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\alber\\Desktop\\IA Project\\BlinkStream\\blinkstream\\src\\components\\UpdateChecker.jsx","messages":[{"ruleId":"no-unused-vars","severity":2,"message":"'checking' is assigned a value but never used.","line":7,"column":10,"messageId":"unusedVar","endLine":7,"endColumn":18,"suggestions":[{"messageId":"removeVar","data":{"varName":"checking"},"fix":{"range":[246,254],"text":""},"desc":"Remove unused variable 'checking'."}]}],"suppressedMessages":[],"errorCount":1,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { useEffect, useState } from 'react'\nimport { check } from '@tauri-apps/plugin-updater'\nimport { relaunch } from '@tauri-apps/plugin-process'\n\nexport 